{
  "name": "invistus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "nx run neotool-web:typecheck",
    "lint": "nx run neotool-web:lint",
    "nx": "nx",
    "check:api": "nx run-many --target=check --projects=security,assets,financialdata,banking,assistant,comms,mcp",
    "check:workers": "nx run-many --target=build,test,lint --projects=bacen-ifdata-cronjob,ratings-job,indicators-job,institution-enhancement-consumer,pdf-extractor,cvm-funds-job,b3-cotahist-job,asset-brand-job",
    "check:web": "nx run-many --target=typecheck,lint,test:unit --projects=neotool-web",
    "check:mobile": "nx run-many --target=typecheck,lint,test --projects=neotool-mobile",
    "check:all": "npm run check:api && npm run check:workers && npm run check:web && npm run check:mobile"
  },
  "devDependencies": {
    "@nx/gradle": "^22.5.1",
    "@nx/next": "^22.5.1",
    "nx": "^22.5.1"
  }
}
