#!/usr/bin/env bash
# neotool-tunnel — gerencia o Cloudflare Tunnel do DevPod on-demand
#
# Dois modos de autenticação:
#
# 1. Token (recomendado para tunnels criados pelo dashboard):
#    No Mac: cloudflared tunnel token <tunnel-id> > ~/.cloudflare/devpod-N.token
#    O arquivo .token é montado no container via bind-mount de ~/.cloudflare
#
# 2. Config file (para tunnels criados com cloudflared tunnel create):
#    Crie ~/.cloudflare/devpod-N.yml com:
#      tunnel: <tunnel-id>
#      credentials-file: /home/dev/.cloudflare/<tunnel-id>.json
#      ingress:
#        - hostname: devpod-N-agent.invistus.com.br
#          service: http://localhost:3285
#        - hostname: devpod-N-web.invistus.com.br
#          service: http://localhost:3000
#        - service: http_status:404

set -euo pipefail

LOG_DIR="${HOME}/.local/share/neotool"
LOG_FILE="$LOG_DIR/cloudflared.log"
PID_FILE="$LOG_DIR/cloudflared.pid"
DEVPOD_N_FILE="$LOG_DIR/devpod-n"
CLOUDFLARE_DIR="${HOME}/.cloudflare"

mkdir -p "$LOG_DIR"

_pid() {
    [ -f "$PID_FILE" ] && cat "$PID_FILE" || echo ""
}

_running() {
    local pid; pid=$(_pid)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

cmd="${1:-status}"

case "$cmd" in
  start)
    n="${2:-}"
    if [ -z "$n" ]; then
        echo "Uso: neotool dev tunnel start <n>  (ex: start 1)"
        exit 1
    fi

    if _running; then
        echo "⚠ Tunnel já está rodando (pid $(_pid)). Use 'neotool dev tunnel stop' primeiro."
        exit 0
    fi

    token_file="$CLOUDFLARE_DIR/devpod-${n}.token"
    config="$CLOUDFLARE_DIR/devpod-${n}.yml"

    if [ -f "$token_file" ]; then
        # Modo token — não precisa de credentials-file nem config
        TOKEN=$(cat "$token_file")
        echo "▶ Iniciando tunnel devpod-${n} via token..."
        nohup cloudflared tunnel --no-autoupdate run --token "$TOKEN" \
            > "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        # Persiste N para o watchdog monitorar este tunnel
        echo "$n" > "$DEVPOD_N_FILE"
    elif [ -f "$config" ]; then
        # Modo config file
        echo "▶ Iniciando tunnel devpod-${n} com $config..."
        nohup cloudflared tunnel --no-autoupdate --config "$config" run \
            > "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        # Persiste N para o watchdog monitorar este tunnel
        echo "$n" > "$DEVPOD_N_FILE"
    else
        echo "❌ Nenhuma config encontrada para devpod-${n}."
        echo ""
        echo "Opção 1 — token (recomendado, tunnel criado pelo dashboard):"
        echo "  No Mac:"
        echo "    cloudflared tunnel token <tunnel-id> > ~/.cloudflare/devpod-${n}.token"
        echo ""
        echo "Opção 2 — config file (tunnel criado via cloudflared CLI):"
        echo "  Crie ~/.cloudflare/devpod-${n}.yml com:"
        cat << YAML
tunnel: <tunnel-id>
credentials-file: /home/dev/.cloudflare/<tunnel-id>.json

ingress:
  - hostname: devpod-${n}-agent.invistus.com.br
    service: http://localhost:3285
  - hostname: devpod-${n}-web.invistus.com.br
    service: http://localhost:3000
  - service: http_status:404
YAML
        exit 1
    fi

    sleep 2

    if _running; then
        echo "✓ Tunnel ativo (pid $(cat $PID_FILE))"
        if [ -f "$config" ]; then
            grep "hostname:" "$config" | awk '{print "  https://"$2}' || true
        fi
        echo ""
        echo "Logs: neotool dev tunnel logs"
    else
        echo "❌ Tunnel falhou ao iniciar. Verifique:"
        tail -5 "$LOG_FILE" 2>/dev/null || true
        exit 1
    fi
    ;;

  stop)
    if _running; then
        kill "$(_pid)" 2>/dev/null || true
        rm -f "$PID_FILE"
        # Limpa devpod-n para o watchdog não tentar reiniciar
        rm -f "$DEVPOD_N_FILE"
        echo "✓ Tunnel parado"
    else
        echo "Tunnel não está rodando"
    fi
    ;;

  status)
    if _running; then
        echo "✓ Tunnel rodando (pid $(_pid))"
        grep -oE 'https://[a-z0-9._-]+\.invistus\.com\.br' "$LOG_FILE" 2>/dev/null | sort -u | sed 's/^/  /' || true
    else
        echo "○ Tunnel parado"
        echo "  Inicie com: neotool dev tunnel start <n>"
    fi
    ;;

  logs)
    tail -f "$LOG_FILE"
    ;;

  *)
    echo "Uso: neotool dev tunnel <start <n>|stop|status|logs>"
    exit 1
    ;;
esac
