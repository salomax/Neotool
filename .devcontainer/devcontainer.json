{
  "name": "Invistus DevPod",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "ROVER_VERSION": "0.40.0",
      "SUPERGRAPH_PLUGIN_VERSION": "2.15.0"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "remoteUser": "dev",
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.cloudflare\" \"${localEnv:HOME}/.vault-keys\" \"${localEnv:HOME}/.claude\" \"${localEnv:HOME}/.codex\"",
  "mounts": [
    {
      "source": "invistus-gradle-cache",
      "target": "/home/dev/.gradle",
      "type": "volume"
    },
    {
      "source": "invistus-npm-cache",
      "target": "/home/dev/.npm",
      "type": "volume"
    },
    {
      "source": "${localEnv:HOME}/.vault-keys",
      "target": "/home/dev/.vault-keys",
      "type": "bind",
      "readonly": true
    },
    {
      "source": "${localEnv:HOME}/.claude",
      "target": "/home/dev/.claude",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.codex",
      "target": "/home/dev/.codex",
      "type": "bind"
    },
    {
      "source": "invistus-web-node-modules",
      "target": "/workspaces/invistus/web/node_modules",
      "type": "volume"
    },
    {
      "source": "invistus-web-next-cache",
      "target": "/workspaces/invistus/web/.next",
      "type": "volume"
    },
    {
      "source": "invistus-kotlin-gradle",
      "target": "/workspaces/invistus/service/kotlin/.gradle",
      "type": "volume"
    },
    {
      "source": "${localEnv:HOME}/.cloudflare",
      "target": "/home/dev/.cloudflare",
      "type": "bind",
      "readonly": true
    }
  ],
  "forwardPorts": [
    3000,
    4000,
    8080,
    8082,
    8083,
    8091,
    5432,
    6432,
    9092,
    9094,
    9000,
    9001,
    3001,
    9090,
    3100,
    3200,
    4317,
    4318,
    8200,
    4242,
    3063,
    3002,
    8088,
    9091,
    8084,
    8092,
    9323
  ],
  "postCreateCommand": {
    "neotool-symlink": "sudo ln -sf /workspaces/invistus/scripts/cli/cli /usr/local/bin/neotool && sudo chmod +x /usr/local/bin/neotool",
    "python-yaml": "sudo apt-get update && sudo apt-get install -y --no-install-recommends python3-yaml",
    "versions": "echo '=== DevPod environment ready ===' && java -version 2>&1 | head -1 && node --version && npm --version && git --version && gh --version | head -1 && (rtk --version 2>&1 || true) && (uv --version 2>&1 || true) && (semble --help >/dev/null && echo 'semble ok' || true) && echo '================================'",
    "setup-env": ".devcontainer/setup-env.sh",
    "setup-rtk": "bash .devcontainer/setup-rtk.sh",
    "setup-semble": "bash .devcontainer/setup-semble.sh",
    "fix-volume-perms": "sudo chown -R dev:dev /home/dev/.gradle /home/dev/.npm /workspaces/invistus/web/node_modules /workspaces/invistus/web/.next /workspaces/invistus/service/kotlin/.gradle 2>/dev/null || true"
  },
  "postStartCommand": ".devcontainer/start-infra.sh",
  "remoteEnv": {
    "NEOTOOL_DEVPOD_N": "1",
    "JAVA_TOOL_OPTIONS": "-Xms256m -Xmx1G",
    "NODE_OPTIONS": "--max-old-space-size=1536",
    "NEXT_TELEMETRY_DISABLED": "1"
  }
}
