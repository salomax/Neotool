#!/usr/bin/env bash
# codex-dev — wrapper Codex com session management, status updates e output limpo
set -euo pipefail

LOG=/tmp/neotool-agent.log
MGR="python3 /workspaces/invistus/.devcontainer/agents/session-mgr.py"
STATUS="/workspaces/invistus/.devcontainer/agents/slack-status.sh"
SESSION=$($MGR load codex 2>/dev/null || true)
# Rejeita SESSION que não seja UUID válido
if [[ ! "$SESSION" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    SESSION=""
fi
THREAD="${NEOTOOL_THREAD:-default}"
MODEL="${NEOTOOL_MODEL:-gpt-5.4}"  # safety net; preferred source is routing.yaml via NEOTOOL_MODEL
T0=$(date +%s%N)

_log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [codex-dev] $*" >> "$LOG"; }

_log "▶ START thread=$THREAD session=${SESSION:-new} prompt=${*:0:120}"
bash "$STATUS" "🔷 _Codex (${MODEL})_ — iniciando..." 2>/dev/null || true

if [ -n "$SESSION" ]; then
    OUTPUT=$(codex exec resume "$SESSION" -m "$MODEL" \
        --dangerously-bypass-approvals-and-sandbox "$*" 2>&1) || \
    OUTPUT=$(codex exec -m "$MODEL" \
        --dangerously-bypass-approvals-and-sandbox "$*" 2>&1)
else
    OUTPUT=$(codex exec -m "$MODEL" \
        --dangerously-bypass-approvals-and-sandbox "$*" 2>&1)
fi

ELAPSED=$(( ($(date +%s%N) - T0) / 1000000 ))

NEW_SESSION=$(echo "$OUTPUT" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -1 || true)
[ -n "$NEW_SESSION" ] && $MGR save codex "$NEW_SESSION" 2>/dev/null || true

_log "✓ DONE elapsed=${ELAPSED}ms session=${NEW_SESSION:-?}"
bash "$STATUS" "🔷 _Codex_ respondeu em $((ELAPSED/1000))s" 2>/dev/null || true

# Extrai apenas o último bloco de texto do codex (descarta banner, tool calls e exec outputs)
RESULT=$(echo "$OUTPUT" | python3 - << 'PYEOF'
import sys, re

raw = sys.stdin.read()

# Divide nas seções de role: "user", "codex", linhas "exec ..."
# Coleta apenas os blocos de texto do papel "codex", descarta exec outputs
codex_blocks = []
current_lines = []
in_codex = False
header_done = False

for line in raw.split('\n'):
    stripped = line.strip()

    if not header_done:
        # Aguarda primeira ocorrência de "user" ou "codex" para sair do header
        if stripped in ('user', 'codex'):
            header_done = True
        else:
            continue

    if stripped == 'codex':
        # Salva bloco anterior se estava em codex
        if in_codex and current_lines:
            codex_blocks.append('\n'.join(current_lines).strip())
        in_codex = True
        current_lines = []
    elif stripped == 'user':
        if in_codex and current_lines:
            codex_blocks.append('\n'.join(current_lines).strip())
        in_codex = False
        current_lines = []
    elif stripped.startswith('exec '):
        # Tool call — salva bloco codex até aqui e pausa coleta
        if in_codex and current_lines:
            codex_blocks.append('\n'.join(current_lines).strip())
            current_lines = []
        in_codex = False  # não coleta exec output
    elif re.match(r'\s*(succeeded|failed) in \d+', line):
        # Resultado inline de exec — ignora; não reseta in_codex
        pass
    elif in_codex:
        current_lines.append(line)

# Último bloco
if in_codex and current_lines:
    codex_blocks.append('\n'.join(current_lines).strip())

# Filtra blocos vazios e pega o último
blocks = [b for b in codex_blocks if b]
if blocks:
    print(blocks[-1])
else:
    # Fallback: remove header e retorna tudo
    m = re.search(r'-{4,}\n', raw)
    print((raw[m.end():] if m else raw).strip()[:3000])
PYEOF
)

_log "  result_preview: ${RESULT:0:300}"

if [ -n "$RESULT" ]; then
    echo "$RESULT"
else
    _log "  WARN: parse vazio, usando raw output"
    echo "$OUTPUT"
fi
