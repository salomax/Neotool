#!/usr/bin/env bash
# claude-dev — wrapper Claude Code com session management + logging
set -euo pipefail

LOG=/tmp/goose-bridge.log
MGR="python3 /workspaces/invistus/.devcontainer/agents/session-mgr.py"
SESSION=$($MGR load claude 2>/dev/null || true)
THREAD="${GOOSE_SESSION_NAME:-default}"
T0=$(date +%s%N)

_log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [claude-dev] $*" >> "$LOG"; }

_log "▶ START thread=$THREAD session=${SESSION:-new} prompt=${*:0:120}"

if [ -n "$SESSION" ]; then
    OUTPUT=$(claude --resume "$SESSION" -p "$*" \
        --dangerously-skip-permissions --output-format json 2>&1) || \
    OUTPUT=$(claude -p "$*" --dangerously-skip-permissions --output-format json 2>&1)
else
    OUTPUT=$(claude -p "$*" --dangerously-skip-permissions --output-format json 2>&1)
fi

ELAPSED=$(( ($(date +%s%N) - T0) / 1000000 ))

# Extrai session_id e tokens do JSON
PARSED=$(echo "$OUTPUT" | python3 -c "
import sys, json
session_id = ''
input_tokens = 0
output_tokens = 0
result_text = ''
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try:
        d = json.loads(line)
        if 'session_id' in d: session_id = d['session_id']
        if 'usage' in d:
            u = d['usage']
            input_tokens += u.get('input_tokens', 0)
            output_tokens += u.get('output_tokens', 0)
        if d.get('type') == 'result':
            result_text = d.get('result', '')
        elif d.get('type') == 'assistant':
            for blk in d.get('message', {}).get('content', []):
                if blk.get('type') == 'text':
                    result_text += blk['text']
    except Exception:
        pass
print(f'{session_id}|{input_tokens}|{output_tokens}|{result_text[:200]}')
" 2>/dev/null || echo "|||")

NEW_SESSION=$(echo "$PARSED" | cut -d'|' -f1)
IN_TOK=$(echo "$PARSED" | cut -d'|' -f2)
OUT_TOK=$(echo "$PARSED" | cut -d'|' -f3)
PREVIEW=$(echo "$PARSED" | cut -d'|' -f4-)

[ -n "$NEW_SESSION" ] && $MGR save claude "$NEW_SESSION" 2>/dev/null || true

_log "✓ DONE elapsed=${ELAPSED}ms session=${NEW_SESSION:-?} in_tokens=${IN_TOK} out_tokens=${OUT_TOK} preview=${PREVIEW:0:100}"

# Output texto
echo "$OUTPUT" | python3 -c "
import sys, json
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try:
        d = json.loads(line)
        if d.get('type') == 'result':
            print(d.get('result', ''))
            break
        if d.get('type') == 'assistant':
            for blk in d.get('message', {}).get('content', []):
                if blk.get('type') == 'text':
                    print(blk['text'])
    except Exception:
        print(line)
" 2>/dev/null || echo "$OUTPUT"
