#!/usr/bin/env bash
# claude-dev — wrapper Claude Code com session management, status updates e output verbatim
set -euo pipefail

LOG=/tmp/neotool-agent.log
MGR="python3 /workspaces/invistus/.devcontainer/agents/session-mgr.py"
STATUS="/workspaces/invistus/.devcontainer/agents/slack-status.sh"
META="/workspaces/invistus/.devcontainer/agents/wrapper_meta.sh"
# Route Claude Code through Headroom (same default as remoteEnv / zshrc).
export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-http://127.0.0.1:8787}"
# shellcheck source=/dev/null
source "$META"
SESSION=$($MGR load claude 2>/dev/null || true)
# Rejeita SESSION que não seja UUID válido (evita usar nome de thread como session ID)
if [[ ! "$SESSION" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    SESSION=""
fi
THREAD="${NEOTOOL_THREAD:-default}"
MODEL="${NEOTOOL_MODEL:-claude-sonnet-4-6}"  # safety net; preferred source is routing.yaml via NEOTOOL_MODEL
T0=$(date +%s%N)

_log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [claude-dev] $*" >> "$LOG"; }

_log "▶ START thread=$THREAD session=${SESSION:-new}"
_log "  prompt: $*"
bash "$STATUS" "🤖 _Claude (${MODEL})_ — iniciando..." 2>/dev/null || true

# Tenta resume se tiver sessão válida; se falhar, limpa e usa nova sessão
if [ -n "$SESSION" ]; then
    _log "  tentando resume session=$SESSION"
    RAW=$(claude --model "$MODEL" --resume "$SESSION" -p "$*" \
        --dangerously-skip-permissions --output-format json 2>&1) || {
        RESUME_EC=$?
        _log "  resume falhou (exit $RESUME_EC): ${RAW:0:200}"
        _log "  limpando sessão inválida e iniciando nova"
        $MGR save claude "" 2>/dev/null || true   # remove sessão ruim
        SESSION=""
        RAW=""
    }
fi

if [ -z "$SESSION" ] || [ -z "$RAW" ]; then
    _log "  nova sessão"
    # Roda sem NEOTOOL_THREAD no env do claude para evitar conflito de nome de sessão
    RAW=$(env -u NEOTOOL_THREAD claude --model "$MODEL" -p "$*" \
        --dangerously-skip-permissions --output-format json 2>&1) || true
fi

EXIT_CODE=$?
ELAPSED=$(( ($(date +%s%N) - T0) / 1000000 ))
_log "  exit_code=$EXIT_CODE elapsed=${ELAPSED}ms raw_chars=${#RAW}"
_log "  raw_preview: ${RAW:0:300}"

# Extrai session_id, tokens e resultado do JSON (campos separados para evitar bug multi-linha)
NEW_SESSION=$(echo "$RAW" | python3 -c "
import sys, json
for line in sys.stdin:
    try:
        d = json.loads(line.strip())
        if 'session_id' in d:
            print(d['session_id'])
            break
    except: pass
" 2>/dev/null || true)

IN_TOK=$(echo "$RAW" | python3 -c "
import sys, json
t=0
for line in sys.stdin:
    try:
        d=json.loads(line.strip())
        t+=d.get('usage',{}).get('input_tokens',0)
    except: pass
print(t)
" 2>/dev/null || echo 0)

OUT_TOK=$(echo "$RAW" | python3 -c "
import sys, json
t=0
for line in sys.stdin:
    try:
        d=json.loads(line.strip())
        t+=d.get('usage',{}).get('output_tokens',0)
    except: pass
print(t)
" 2>/dev/null || echo 0)

RESULT=$(echo "$RAW" | python3 -c "
import sys, json
result=''
for line in sys.stdin:
    line=line.strip()
    if not line: continue
    try:
        d=json.loads(line)
        if d.get('type')=='result':
            result=d.get('result','')
        elif d.get('type')=='assistant':
            for blk in d.get('message',{}).get('content',[]):
                if blk.get('type')=='text':
                    result+=blk['text']
    except: pass
print(result)
" 2>/dev/null || true)

[ -n "$NEW_SESSION" ] && $MGR save claude "$NEW_SESSION" 2>/dev/null || true

_log "  session_id=${NEW_SESSION:-?} in=${IN_TOK} out=${OUT_TOK}"
_log "  result_preview: ${RESULT:0:200}"

bash "$STATUS" "🤖 _Claude_ respondeu em $((ELAPSED/1000))s (in:${IN_TOK} out:${OUT_TOK})" 2>/dev/null || true

# Output: prefere resultado parseado, fallback para raw se vazio
if [ -n "$RESULT" ]; then
    echo "$RESULT"
    emit_wrapper_meta "$IN_TOK" "$OUT_TOK" 0
elif [ -n "$RAW" ]; then
    _log "  WARN: JSON parse vazio, usando raw output"
    echo "$RAW"
    emit_wrapper_meta "$IN_TOK" "$OUT_TOK" 0
else
    _log "  ERROR: sem output do Claude (exit=$EXIT_CODE)"
    echo "(sem resposta do Claude — exit code $EXIT_CODE)"
    emit_wrapper_meta "$IN_TOK" "$OUT_TOK" "${EXIT_CODE:-1}"
fi
