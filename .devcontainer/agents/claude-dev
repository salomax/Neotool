#!/usr/bin/env bash
# claude-dev — wrapper Claude Code com session management, status updates e output verbatim
set -euo pipefail

LOG=/tmp/goose-bridge.log
MGR="python3 /workspaces/invistus/.devcontainer/agents/session-mgr.py"
STATUS="/workspaces/invistus/.devcontainer/agents/slack-status.sh"
SESSION=$($MGR load claude 2>/dev/null || true)
THREAD="${GOOSE_SESSION_NAME:-default}"
T0=$(date +%s%N)

_log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [claude-dev] $*" >> "$LOG"; }

_log "▶ START thread=$THREAD session=${SESSION:-new} prompt=${*:0:120}"
bash "$STATUS" "🤖 _Claude (sonnet-4-6)_ — iniciando..." 2>/dev/null || true

if [ -n "$SESSION" ]; then
    OUTPUT=$(claude --model claude-sonnet-4-6 --resume "$SESSION" -p "$*" \
        --dangerously-skip-permissions --output-format json 2>&1) || \
    OUTPUT=$(claude --model claude-sonnet-4-6 -p "$*" \
        --dangerously-skip-permissions --output-format json 2>&1)
else
    OUTPUT=$(claude --model claude-sonnet-4-6 -p "$*" \
        --dangerously-skip-permissions --output-format json 2>&1)
fi

ELAPSED=$(( ($(date +%s%N) - T0) / 1000000 ))

# Extrai session_id e tokens
PARSED=$(echo "$OUTPUT" | python3 -c "
import sys, json
session_id = ''; in_tok = 0; out_tok = 0; result_text = ''
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try:
        d = json.loads(line)
        if 'session_id' in d: session_id = d['session_id']
        if 'usage' in d:
            u = d['usage']
            in_tok += u.get('input_tokens', 0)
            out_tok += u.get('output_tokens', 0)
        if d.get('type') == 'result':
            result_text = d.get('result', '')
        elif d.get('type') == 'assistant':
            for blk in d.get('message', {}).get('content', []):
                if blk.get('type') == 'text':
                    result_text += blk['text']
    except Exception: pass
print(f'{session_id}|||{in_tok}|||{out_tok}|||{result_text}')
" 2>/dev/null || echo "||||||")

NEW_SESSION=$(echo "$PARSED" | cut -d'|' -f1 | tr -d '|')
IN_TOK=$(echo "$PARSED"     | awk -F'\\|\\|\\|' '{print $2}')
OUT_TOK=$(echo "$PARSED"    | awk -F'\\|\\|\\|' '{print $3}')
RESULT=$(echo "$PARSED"     | awk -F'\\|\\|\\|' '{print $4}')

[ -n "$NEW_SESSION" ] && $MGR save claude "$NEW_SESSION" 2>/dev/null || true

_log "✓ DONE elapsed=${ELAPSED}ms session=${NEW_SESSION:-?} in=${IN_TOK} out=${OUT_TOK}"
bash "$STATUS" "🤖 _Claude_ respondeu em $((ELAPSED/1000))s (in:${IN_TOK} out:${OUT_TOK})" 2>/dev/null || true

# Output VERBATIM — sem modificação
echo "$RESULT"
