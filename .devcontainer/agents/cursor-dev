#!/usr/bin/env bash
# cursor-dev — wrapper Cursor CLI com session management + logging
set -euo pipefail

LOG=/tmp/goose-bridge.log
MGR="python3 /workspaces/invistus/.devcontainer/agents/session-mgr.py"
SESSION=$($MGR load cursor 2>/dev/null || true)
THREAD="${GOOSE_SESSION_NAME:-default}"
T0=$(date +%s%N)

_log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [cursor-dev] $*" >> "$LOG"; }

_log "▶ START thread=$THREAD session=${SESSION:-new} prompt=${*:0:120}"

if [ -n "$SESSION" ]; then
    OUTPUT=$(agent --model auto --resume="$SESSION" "$*" 2>&1) || \
    OUTPUT=$(agent --model auto "$*" 2>&1)
else
    OUTPUT=$(agent --model auto "$*" 2>&1)
fi

ELAPSED=$(( ($(date +%s%N) - T0) / 1000000 ))

NEW_SESSION=$(echo "$OUTPUT" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -1 || true)
[ -n "$NEW_SESSION" ] && $MGR save cursor "$NEW_SESSION" 2>/dev/null || true

PREVIEW=$(echo "$OUTPUT" | tail -3 | tr '\n' ' ' | cut -c1-150)
_log "✓ DONE elapsed=${ELAPSED}ms session=${NEW_SESSION:-?} preview=$PREVIEW"

echo "$OUTPUT"
