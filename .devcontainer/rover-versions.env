# Pin versions for Apollo Rover + composition plugin (supergraph).
# Bump intentionally; then rebuild via: ./neotool dev up --recreate
# generate-schema.sh passes --federation-version =${SUPERGRAPH_PLUGIN_VERSION}
# so compose with --skip-update finds the baked plugin binary.
ROVER_VERSION=0.40.0
SUPERGRAPH_PLUGIN_VERSION=2.15.0
