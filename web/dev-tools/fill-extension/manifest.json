{
  "manifest_version": 2,
  "name": "Invistus Dev Helper",
  "version": "2.0.0",
  "description": "Dev helper para autofill de formulários em localhost",
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://localhost:3000/*"],
      "js": [
        "helpers.js",
        "actions/investments.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "http://localhost/*",
    "http://localhost:3000/*"
  ]
}
