# =============================================================================
# Development Environment Defaults
# =============================================================================
# Gerado automaticamente pelo postCreateCommand do DevPod.
# Copie para .env.local e ajuste se necessário.
# Valores aqui são seguros para dev — NÃO usar em produção.
# =============================================================================

NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_API_URL=http://localhost:8080
SITE_URL=http://localhost:3000

# Google OAuth (client ID de dev)
GOOGLE_CLIENT_ID=573386613456-apnv0hmvp4c6b3nrb14i39lk223j5iai.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=573386613456-apnv0hmvp4c6b3nrb14i39lk223j5iai.apps.googleusercontent.com

# Unleash Feature Flags (dev tokens)
NEXT_PUBLIC_UNLEASH_PROXY_URL=https://unleash.invistus.com.br/api/frontend
NEXT_PUBLIC_UNLEASH_CLIENT_TOKEN=*:development.3f0f302aed704dc1ac693780006d20220391ed2a6d57415a8c79a625
UNLEASH_PROXY_URL=https://unleash.invistus.com.br/api/frontend
UNLEASH_CLIENT_TOKEN=*:development.3f0f302aed704dc1ac693780006d20220391ed2a6d57415a8c79a625

RUNTIME_ENV=development
BANKING_SERVICE_INTERNAL_URL=http://localhost:8092

# Desabilita telemetria do Next.js (desnecessária em ambiente de dev/devpod)
NEXT_TELEMETRY_DISABLED=1

# Limita heap do Node para evitar OOM/panic do Turbopack em ambientes com pouca RAM
NODE_OPTIONS=--max-old-space-size=2048
