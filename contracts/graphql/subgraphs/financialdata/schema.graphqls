# ============================================================================
# Base Schema - Common Scalars
# Auto-included from: service/kotlin/common/src/main/resources/graphql/base-schema.graphqls
# ============================================================================

scalar Long
scalar Date
scalar DateTime
scalar JSON
scalar UUID

# ============================================================================
# Service Schema - financialdata
# ============================================================================

# External type reference - Asset is defined in the assets subgraph
# This is a stub type for federation - the full type is defined in the assets subgraph
# The id field is provided by this subgraph (from assetId in our data), and federation
# will use it to resolve the full Asset entity from the assets subgraph
type Asset @key(fields: "id") {
  id: ID!
}

# Query type for financial data operations
extend type Query {
  # Institution search queries
  # anoMes: Quarter filter (YYYYMM format). If not provided, uses latest quarter globally.
  searchBacenInstitutionsAutocomplete(query: String!, anoMes: String): BacenInstitutionAutocompleteConnection!
  bacenInstitutions(query: String, anoMes: String, first: Int, after: String): BacenInstitutionConnection!
  # Minimal listing (id, name, updatedAt) for sitemap/URL building. Relay pagination.
  bacenInstitutionSlugs(anoMes: String, first: Int, after: String): BacenInstitutionSlugConnection!
  # Institution detail query
  # anoMes: Quarter filter (YYYYMM format). If not provided, uses latest quarter globally.
  bacenFinanceInstitution(id: ID!, anoMes: String): BacenFinanceInstitution
  # Rating issuers
  ratingIssuers: [RatingIssuer!]!
  # Economic indicators
  economicIndicators(label: String): [EconomicIndicator!]!
  # Latest value per indicator+variation (used by banking for fixed-income valuation).
  indicatorsLatest: [EconomicIndicatorLatestItem!]!
  # Fixed income comparison: 2×3 grid of equivalent rates (product group × rate model)
  fixedIncomeComparison(input: FixedIncomeComparisonInput!): FixedIncomeComparisonResult!
  # Institution discovery dashboard: popular list with top metrics per institution
  popularInstitutions(anoMes: String): [PopularInstitution!]!
  # Investment fund queries (CVM)
  searchInvestmentFundsAutocomplete(query: String!): InvestmentFundAutocompleteConnection!
  investmentFunds(query: String, assetType: InvestmentFundAssetType, isActive: Boolean, first: Int, after: String): InvestmentFundConnection!
  investmentFund(id: ID!): InvestmentFund
  investmentFundMarketSnapshots(cnpjs: [String!]!): [InvestmentFundMarketSnapshot!]!
  # Daily NAV series for a CVM fund by CNPJ (chronological). Empty when unknown CNPJ or no rows in range.
  fundNavSeries(cnpj: String!, from: Date!, to: Date!): [FundDailyNav!]!
  fundDailyNavs(from: Date!, to: Date!, first: Int!, after: String, updatedSince: DateTime, cnpjs: [String!]): FundDailyNavConnection!

  # B3 investment asset queries (equities, FIIs, options)
  searchInvestmentAssetsAutocomplete(query: String!, assetType: B3AssetType): ListedAssetAutocompleteConnection!
  investmentAssets(query: String, assetType: B3AssetType, isActive: Boolean, first: Int, after: String): ListedAssetConnection!
  investmentAssetByTicker(ticker: String!): ListedAsset
  investmentAssetsByTickers(tickers: [String!]!): [ListedAsset!]!
  listedAssetDailyPrices(from: Date!, to: Date!, first: Int!, after: String, updatedSince: DateTime, tickers: [String!]): ListedAssetDailyPriceConnection!
  economicIndicatorVariationPoints(from: Date!, to: Date!, first: Int!, after: String, updatedSince: DateTime, indicators: [String!], variations: [String!]): EconomicIndicatorPointConnection!
  assetCorporateEvents(from: Date!, to: Date!, first: Int!, after: String, updatedSince: DateTime, tickers: [String!], isins: [String!]): AssetCorporateEventConnection!
}

# Enums
enum BacenInstitutionType {
  INDIVIDUAL_INSTITUTION
  PRUDENTIAL_GROUP
  FINANCIAL_GROUP
}

enum BacenControlType {
  PUBLIC
  PRIVATE_DOMESTIC
  PRIVATE_FOREIGN_CONTROL
}

enum BacenInstitutionBankType {
  B1
  B2
  B3S
  B3C
  B4
  N1
  N2
  N4
}

enum DataRestrictionReason {
  INSTITUTION_REQUEST
}

enum TopInstitutionMetric {
  PROFIT
  BASILEIA_INDEX
  MOBILIZATION_INDEX
}

type DataRestriction {
  isRestricted: Boolean!
  reason: DataRestrictionReason
}

# Institution search types
type BacenInstitutionAutocompleteConnection {
  suggestions: [BacenInstitutionAutocompleteItem!]!
}

type BacenInstitutionAutocompleteItem {
  name: String!
}

type BacenInstitutionConnection {
  edges: [BacenInstitutionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type BacenInstitutionEdge {
  node: BacenInstitutionSummaryItem!
  cursor: String!
}

type BacenInstitutionSummaryItem {
  id: ID!
  name: String!
  legalName: String
  tradeName: String
  logoAsset: Asset
  profit: Float
  equity: Float
  yoyEquityGrowth: Float
  basileiaIndex: Float
  bacenInstitutionType: String
  institutionType: BacenInstitutionType
  tipoConsolidadoBancario: String
  dataRestriction: DataRestriction
}

# Institution discovery dashboard types
type PopularInstitution {
  rank: Int!
  shortDescription: String!
  quarter: String!
  year: Int
  month: Int
  institution: BacenInstitutionSummaryItem!
  popularInstitutionTopMetrics: [PopularInstitutionTopMetric!]!
}

type PopularInstitutionTopMetric {
  metric: TopInstitutionMetric!
  popularInstitutionTopMetricItem: PopularInstitutionTopMetricItem!
}

type PopularInstitutionTopMetricItem {
  rank: Int!
  institution: BacenInstitutionSummaryItem!
  metricValue: Float
}

# PageInfo type owned only by this subgraph (avoids shared PageInfo with SECURITY
# so the router execution plan only calls FINANCIALDATA for bacenInstitutionSlugs).
type FinancialDataPageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

# Institution slug listing (id, name, updatedAt) for sitemap/URL building
type BacenInstitutionSlugConnection {
  edges: [BacenInstitutionSlugEdge!]!
  pageInfo: FinancialDataPageInfo!
}

type BacenInstitutionSlugEdge {
  node: BacenInstitutionSlug!
  cursor: String!
}

type BacenInstitutionSlug {
  id: ID!
  name: String!
  updatedAt: DateTime
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

# Institution detail types
type BacenFinanceInstitution {
  id: ID!
  quarter: String
  updatedAt: DateTime
  name: String!
  asset: Asset
  legalName: String
  tradeName: String
  logoAsset: Asset
  institutionType: BacenInstitutionType
  controlType: BacenControlType
  institutionBankType: BacenInstitutionBankType
  tipoConsolidadoBancario: BacenInstitutionBankType
  website: String
  socialNetworks: [String!]
  mainActivity: String
  address: String
  founded: String
  rwaReferenceEquity: Float
  dataRestriction: DataRestriction

  # Reports
  reportsSummary(range: QuarterRangeInput!): ReportsAvailability!
  reportDetails(reportId: ID!, range: QuarterRangeInput!): ReportDetails!

  """
  Current ratings from all issuers for this institution
  """
  ratings: [InstitutionRating!]

  """
  Historical rating changes for this institution
  """
  ratingHistory(limit: Int = 50): [RatingHistory!]
}

input QuarterRangeInput {
  from: String # "YYYYMM"
  to: String   # "YYYYMM"
  last: Int
}

input IndicatorRangeInput {
  from: Date
  to: Date
  last: Int
}

type ReportsAvailability {
  quarters: [QuarterReports!]!
}

type QuarterReports {
  quarter: String! # "YYYYMM"
  reports: [ReportDescriptor!]!
}

type ReportDescriptor {
  reportId: ID!
  name: String
  # Optional fields - only present in reportDetails, not in reportsSummary
  group: String
  id: String
}

type ReportDetails {
  reportId: ID!
  name: String
  accounts: [ReportAccount!]!
}

type ReportAccount {
  group: String
  id: String
  name: String
  valuesByQuarter: [QuarterValue!]!
}

type QuarterValue {
  quarter: String! # "YYYYMM"
  value: Float
}

# Ratings types
type RatingIssuer {
  id: ID!
  code: String!
  name: String!
  website: String
  logoAssetId: String
}

type InstitutionRating {
  id: ID!
  name: String!
  label: String!
  ratingDate: Date!
  customParams: JSON
  issuer: RatingIssuer!
  updatedAt: DateTime!
}

type RatingHistory {
  id: ID!
  name: String!
  label: String!
  ratingDate: Date!
  customParams: JSON
  issuerCode: String!
  changedAt: DateTime!
}

# Economic indicators
type EconomicIndicator {
  id: ID!
  countryCode: String!
  label: String!
  issuer: String!
  description: String
  frequency: String!
  unit: String!
  isActive: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
  variations(label: String): [EconomicIndicatorVariation!]!
}

type EconomicIndicatorVariation {
  id: ID!
  label: String!
  unit: String
  isDefault: Boolean!
  incrementalMonths: Int
  incrementalYears: Int
  incrementalDays: Int
  series(range: IndicatorRangeInput, limit: Int): EconomicIndicatorVariationSeries
}

type EconomicIndicatorVariationSeries {
  unit: String
  values: [EconomicIndicatorPoint!]!
}

type EconomicIndicatorPoint {
  referenceDate: Date!
  value: Float!
}

type EconomicIndicatorPointConnection {
  edges: [EconomicIndicatorPointEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type EconomicIndicatorPointEdge {
  node: EconomicIndicatorPointNode!
  cursor: String!
}

type EconomicIndicatorPointNode {
  indicator: String!
  variation: String!
  unit: String
  referenceDate: Date!
  publicationDate: Date
  value: Float!
  updatedAt: DateTime!
}

# Flat list of latest value per indicator+variation (for banking valuation).
type EconomicIndicatorLatestItem {
  indicator: String!
  variation: String!
  latest: EconomicIndicatorPoint
}

# Fixed income comparison (simulator)
enum FixedIncomeProduct {
  CDB
  LC
  LCI
  LCA
  DEBENTURE
  FREE_TAX_DEBENTURE
}

enum FixedIncomeRateModel {
  CDI
  FIXED
  IPCA_PLUS
}

enum FixedIncomeProductGroup {
  TAXABLE_IR
  TAXABLE_IR_NO_IOF
  EXEMPT_IR
}

input FixedIncomeComparisonInput {
  productGroup: FixedIncomeProductGroup!
  product: FixedIncomeProduct
  principal: Float!
  startDate: Date!
  endDate: Date!
  rateModel: FixedIncomeRateModel!
  contractedRateBps: Int!
  cdiAnnualRateBps: Int!
  ipcaAnnualRateBps: Int!
}

type FixedIncomeComparisonResult {
  summary: FixedIncomeSummary!
  rows: [FixedIncomeComparisonRow!]!
  performanceSeries: [FixedIncomePerformanceSeries!]!
  methodology: FixedIncomeMethodology!
}

type FixedIncomeSummary {
  baseProduct: FixedIncomeProduct!
  baseProductGroup: FixedIncomeProductGroup!
  baseRateModel: FixedIncomeRateModel!
  baseEquivalentRateBps: Int!
  baseRateDisplay: String!
  principal: Float!
  gross: Float!
  ir: Float!
  net: Float!
  realGainPercent: Float!
}

type FixedIncomeComparisonRow {
  label: String!
  productGroup: FixedIncomeProductGroup!
  rateModel: FixedIncomeRateModel!
  equivalentRateBps: Int!
  contractedRateDisplay: String!
  gross: Float!
  ir: Float!
  net: Float!
  realGainPercent: Float!
  isExempt: Boolean!
  isBase: Boolean!
}

type FixedIncomePerformanceSeries {
  productGroup: FixedIncomeProductGroup!
  points: [FixedIncomePerformancePoint!]!
}

type FixedIncomePerformancePoint {
  date: Date!
  netValue: Float!
}

type FixedIncomeMethodology {
  dayCount: FixedIncomeDayCountMethodology!
  tax: FixedIncomeTaxMethodology!
}

type FixedIncomeDayCountMethodology {
  accrualConvention: String!
  calendarDays: Int!
  businessDays: Int!
}

type FixedIncomeTaxMethodology {
  appliesOnProfitOnly: Boolean!
  activeBracket: FixedIncomeTaxBracket!
  bracketTable: [FixedIncomeTaxBracket!]!
}

type FixedIncomeTaxBracket {
  fromCalendarDays: Int!
  toCalendarDays: Int
  rateDecimal: Float!
}

