# ============================================================================
# Service Schema - mcp
# ============================================================================

type Query {
  _placeholder: String
}

type Mutation {
  _placeholder: String
}

type Subscription {
  _placeholder: String
}

enum McpToolCallOutcome {
  SUCCESS
  ERROR
  REJECTED
}

type McpConnectionRevocation {
  userId: ID!
  clientId: String!
  accountId: ID!
  revokedAt: DateTime!
  revokedUntil: DateTime
  reason: String
}

type McpRecentActivityEntry {
  id: ID!
  occurredAt: DateTime!
  userId: ID!
  clientId: String!
  tokenId: String
  toolName: String
  outcome: McpToolCallOutcome!
  errorCode: String
  errorMessage: String
  latencyMs: Long!
  createdAt: DateTime!
}

extend type Query {
  recentActivity(userId: ID!, clientId: String!, first: Int = 20): [McpRecentActivityEntry!]!
}

extend type Mutation {
  revokeConnection(userId: ID!, clientId: String!, accountId: ID!): McpConnectionRevocation!
}
