# Base GraphQL Schema - Framework Level
# This contains common types and directives used across all modules

directive @key(fields: String!) repeatable on OBJECT | INTERFACE

# Common scalar types
scalar Long
scalar DateTime
scalar UUID

# Common query patterns
type Query {
  # Placeholder - modules will extend this
  _placeholder: String
}

# Common mutation patterns  
type Mutation {
  # Placeholder - modules will extend this
  _placeholder: String
}

# Common subscription patterns
type Subscription {
  # Placeholder - modules will extend this
  _placeholder: String
}

# ============================================================================
# Service Schema - assistant
# ============================================================================

type Query {
  # Get conversation context for a session
  conversation(sessionId: String!): Conversation
}

type Mutation {
  # Send a chat message and get AI assistant response
  chat(input: ChatInput!): ChatResponse!
  
  # Clear conversation history for a session
  clearConversation(sessionId: String!): Boolean!
}

input ChatInput {
  sessionId: String!
  message: String!
}

type ChatResponse {
  sessionId: String!
  response: String!
}

type Conversation {
  sessionId: String!
  messageCount: Int!
  lastMessage: String
}

