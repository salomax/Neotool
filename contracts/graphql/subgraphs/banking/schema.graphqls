# ============================================================================
# Base Schema - Common Scalars
# Auto-included from: service/kotlin/common/src/main/resources/graphql/base-schema.graphqls
# ============================================================================

scalar Long
scalar Date
scalar DateTime
scalar JSON
scalar UUID

# ============================================================================
# Service Schema - banking
# ============================================================================

# External type reference — Asset is defined in the assets subgraph.
# Federation resolves the full type from the assets service using the id.
type Asset @key(fields: "id") {
  id: ID!
}

# ============================================================================
# Issuer
# ============================================================================

"""
Financial institution (bank, fintech, card network, etc.) associated with an account.
Seeded from BACEN data. logo_key holds the asset UUID resolved via federation.
"""
type Issuer {
  id: ID!
  name: String!
  domain: String
  """COMPE code (3 digits) — Brazilian interbank clearing system. Null for fintechs without it."""
  compeCode: String
  """ISPB code (8 digits) — Central Bank identifier. Null for non-BACEN issuers."""
  ispb: String
  countryCode: String!
  """Raw asset UUID stored for this issuer's logo. Null until logo hydration runs."""
  logoKey: String
  """Federation reference to the logo Asset (PUBLIC, institution-logos bucket). Null until hydrated."""
  logoAsset: Asset
}

# ============================================================================
# Queries
# ============================================================================

extend type Query {
  _bankingService: String
  """All active issuers. Small list — no pagination or filter needed."""
  issuers: [Issuer!]!
}

# ============================================================================
# Mutations
# ============================================================================

extend type Mutation {
  _bankingService: String
}
