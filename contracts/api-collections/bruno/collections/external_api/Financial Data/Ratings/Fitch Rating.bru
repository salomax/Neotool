    "query":"query Ratables($language: String, $slug: String\041) {\\n  getEntity(language: $language, slug: $slug) {\\n    id\\n    ratables {\\n      amount\\n      bond\\n      className\\n      commercialPaperType\\n      currency\\n      couponRate\\n      deal\\n      dealReviewDate\\n      debtLevel\\n      marketSectorVOList {\\n        name\\n        __typename\\n      }\\n      disclosures {\\n        regulatoryAgency\\n        status\\n        postBrexitRegAgency\\n        __typename\\n      }\\n      marketing {\\n        sectors {\\n          name\\n          slug\\n          __typename\\n        }\\n        translatedEntityNames {\\n          default\\n          countries {\\n            name\\n            slug\\n            __typename\\n          }\\n          language {\\n            name\\n            slug\\n            __typename\\n          }\\n          translatedValue\\n          __typename\\n        }\\n        __typename\\n      }\\n      solicitationTypeDescription\\n      exemption\\n      id\\n      identifiers {\\n        placement\\n        type\\n        value\\n        __typename\\n      }\\n      issue\\n      issuer\\n      market\\n      endDate: maturityDate\\n      placement\\n      program\\n      ratableRatings {\\n        filterInvestmentGradeType\\n        filterNationalRatingType\\n        filterRatingType\\n        orangeDisplay\\n        correctionFlag\\n        changeDate\\n        ratingActionDescription\\n        ratingActionReasonID\\n        ratingActionReasonDescription\\n        ratingAlertCode\\n        ratingCode\\n        ratingEffectiveDate\\n        ratingId\\n        ratingLocalActionDescription\\n        ratingLocalValue\\n        ratingTypeDescription\\n        recoveryEstimate\\n        recoveryRatingValue\\n        __typename\\n      }\\n      ratableTypeDescription\\n      recoveryEstimate\\n      security\\n      series\\n      size\\n      subClass\\n      subgroupName\\n      transaction\\n      transactionSecurityID\\n      type\\n      __typename\\n    }\\n    inactiveRatables {\\n      amount\\n      bond\\n      className\\n      commercialPaperType\\n      currency\\n      couponRate\\n      deal\\n      dealReviewDate\\n      debtLevel\\n      marketing {\\n        sectors {\\n          name\\n          slug\\n          __typename\\n        }\\n        __typename\\n      }\\n      disclosures {\\n        regulatoryAgency\\n        status\\n        postBrexitRegAgency\\n        __typename\\n      }\\n      marketing {\\n        sectors {\\n          name\\n          slug\\n          __typename\\n        }\\n        __typename\\n      }\\n      solicitationTypeDescription\\n      exemption\\n      id\\n      identifiers {\\n        placement\\n        type\\n        value\\n        __typename\\n      }\\n      issue\\n      issuer\\n      market\\n      endDate: maturityDate\\n      placement\\n      program\\n      ratableRatings {\\n        filterInvestmentGradeType\\n        filterNationalRatingType\\n        ratingActionReasonID\\n        ratingActionReasonDescription\\n        filterRatingType\\n        orangeDisplay\\n        correctionFlag\\n        changeDate\\n        ratingActionDescription\\n        ratingAlertCode\\n        ratingCode\\n        ratingEffectiveDate\\n        ratingId\\n        ratingLocalActionDescription\\n        ratingLocalValue\\n        ratingTypeDescription\\n        recoveryEstimate\\n        recoveryRatingValue\\n        __typename\\n      }\\n      ratableTypeDescription\\n      recoveryEstimate\\n      security\\n      series\\n      size\\n      subClass\\n      subgroupName\\n      transaction\\n      transactionSecurityID\\n      type\\n      __typename\\n    }\\n    __typename\\n  }\\n  getUspfTransaction(language: $language, slug: $slug) {\\n    id\\n    ratablesList {\\n      transactionSecurityTypeDescription\\n      transactionSecurityID\\n      issuerList {\\n        issuerName\\n        issuerBondList {\\n          bondName\\n          ratables {\\n            amount\\n            bond\\n            className\\n            currency\\n            couponRate\\n            deal\\n            debtLevel\\n            exemption\\n            issue\\n            issuer\\n            market\\n            endDate: maturityDate\\n            placement\\n            program\\n            recoveryEstimate\\n            security\\n            series\\n            size\\n            subClass\\n            transaction\\n            transactionSecurityID\\n            type\\n            commercialPaperType\\n            subgroupName\\n            ratableTypeDescription\\n            dealReviewDate\\n            marketing {\\n              sectors {\\n                name\\n                slug\\n                __typename\\n              }\\n              __typename\\n            }\\n            disclosures {\\n              regulatoryAgency\\n              status\\n              postBrexitRegAgency\\n              __typename\\n            }\\n            solicitationTypeDescription\\n            id\\n            identifiers {\\n              type\\n              value\\n              placement\\n              __typename\\n            }\\n            ratableRatings {\\n              ratingId\\n              ratingEffectiveDate\\n              ratingCode\\n              ratingAlertCode\\n              ratingActionDescription\\n              ratingActionReasonID\\n              ratingActionReasonDescription\\n              ratingTypeDescription\\n              recoveryRatingValue\\n              recoveryEstimate\\n              ratingLocalValue\\n              ratingLocalActionDescription\\n              filterRatingType\\n              filterNationalRatingType\\n              filterInvestmentGradeType\\n              orangeDisplay\\n              correctionFlag\\n              changeDate\\n              __typename\\n            }\\n            __typename\\n          }\\n          __typename\