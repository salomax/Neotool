meta {
  name: Fitch Rating (Example)
  type: http
  seq: 2
}

post {
  url: https://api.fitchratings.com/
  body: json
  auth: inherit
}

headers {
  User-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:147.0) Gecko/20100101 Firefox/147.0
  Accept: */*
  Accept-Language: en-US,en;q=0.9
  Referer: https://www.fitchratings.com/
  content-type: application/json
  Origin: https://www.fitchratings.com
  Connection: keep-alive
  Sec-Fetch-Dest: empty
  Sec-Fetch-Mode: cors
  Sec-Fetch-Site: same-site
  Priority: u=4
}

body:json {
  {
    "operationName": "Entity",
    "variables": {
      "slug": "banco-do-brasil-sa-80089721"
    },
    "query":"query Entity($slug: String\041) {\\n  getEntity(slug: $slug) {\\n    slug\\n   name\\n    id\\n    identifiers {\\n      type\\n      value\\n     }\\n    ratings {\\n      id\\n      orangeDisplay\\n      correctionFlag\\n      ratingChangeDate\\n      ratingActionDescription\\n      ratingCode\\n      ratingAlertCode\\n      ratingEffectiveDate\\n      ratingTypeDescription\\n      ratingLocalValue\\n      ratingLocalActionDescription\\n      recoveryRatingValue\\n      }\\n    }\\n}\\n"
  }
}

settings {
  encodeUrl: false
}
