meta {
  name: Get Bacen Finance Institution
  type: graphql
  seq: 5
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query GetBacenFinanceInstitution($id: ID!, $anoMes: String) {
    bacenFinanceInstitution(id: $id, anoMes: $anoMes) {
      id
      quarter
      name
      legalName
      tradeName
      logoAsset {
        id
        publicUrl
      }
      updatedAt
      institutionType
      controlType
      institutionBankType
      tipoConsolidadoBancario
      website
      socialNetworks
      mainActivity
      address
      founded
      ratings {
        id
        name
        label
        ratingDate
        issuer {
          id
          code
          name
          website
          logoAssetId
        }
        updatedAt
      }
      ratingHistory(limit: 10) {
        id
        name
        label
        ratingDate
        issuerCode
        changedAt
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "C0080075",
    "anoMes": "202509"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Has institution data", function() {
    const data = res.getBody();
    expect(data.data.bacenFinanceInstitution).to.be.an('object');
  });
  
  test("Has id", function() {
    const data = res.getBody();
    expect(data.data.bacenFinanceInstitution.id).to.be.a('string');
  });
  
  test("Has ratings array (optional)", function() {
    const data = res.getBody();
    expect(data.data.bacenFinanceInstitution.ratings).to.be.an('array');
  });
  
  test("Has rating history array (optional)", function() {
    const data = res.getBody();
    expect(data.data.bacenFinanceInstitution.ratingHistory).to.be.an('array');
  });
}
