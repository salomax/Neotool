meta {
  name: Get Economic Indicators Series
  type: graphql
  seq: 9
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query EconomicIndicatorsSeries($range: IndicatorRangeInput, $limit: Int, $indicatorLabel: String, $variationLabel: String) {
    economicIndicators(label: $indicatorLabel) {
      label
      variations(label: $variationLabel) {
        label
        series(range: $range, limit: $limit) {
          unit
          values {
            referenceDate
            value
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "range": {
      "from": "2023-01-01",
      "to": "2026-01-01",
      "last": null
    },
    "limit": 24,
    "indicatorLabel": "TR",
    "variationLabel": null
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Has economicIndicators", function() {
    const data = res.getBody();
    expect(data.data.economicIndicators).to.be.an('array');
  });
}
