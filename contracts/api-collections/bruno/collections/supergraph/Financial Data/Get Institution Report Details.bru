meta {
  name: Get Institution Report Details
  type: graphql
  seq: 6
}

post {
  url: http://{{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query GetInstitutionReportDetails($id: ID!, $anoMes: String, $reportId: ID!, $range: QuarterRangeInput!) {
    bacenFinanceInstitution(id: $id, anoMes: $anoMes) {
      id
      name
      reportDetails(reportId: $reportId, range: $range) {
        reportId
        name
        group
        accountNumber
        columnName
        valuesByQuarter {
          quarter
          value
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "C0080075",
    "anoMes": "202509",
    "reportId": "1",
    "range": {
      "last": 20
    }
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Has report details", function() {
    const data = res.getBody();
    expect(data.data.bacenFinanceInstitution.reportDetails).to.be.an('object');
  });
  
  test("Has values by quarter", function() {
    const data = res.getBody();
    expect(data.data.bacenFinanceInstitution.reportDetails.valuesByQuarter).to.be.an('array');
  });
}
