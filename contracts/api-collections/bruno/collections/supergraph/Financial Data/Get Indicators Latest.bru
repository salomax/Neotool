meta {
  name: Get Indicators Latest
  type: graphql
  seq: 10
}

post {
  url: http://{{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query IndicatorsLatest {
    indicatorsLatest {
      indicator
      variation
      unit
      latest {
        referenceDate
        value
      }
    }
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Has indicatorsLatest array", function() {
    const data = res.getBody();
    expect(data.data.indicatorsLatest).to.be.an('array');
  });

  test("Each item has required fields", function() {
    const data = res.getBody();
    const items = data.data.indicatorsLatest;
    if (items.length > 0) {
      const item = items[0];
      expect(item).to.have.property('indicator');
      expect(item).to.have.property('variation');
      expect(item).to.have.property('unit');
    }
  });
}
