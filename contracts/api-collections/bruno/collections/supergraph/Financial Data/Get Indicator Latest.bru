meta {
  name: Get Indicator Latest
  type: graphql
  seq: 9
}

post {
  url: http://{{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query IndicatorLatest($indicator: String!, $variation: String!) {
    indicatorLatest(indicator: $indicator, variation: $variation) {
      referenceDate
      value
    }
  }
}

body:graphql:vars {
  {
    "indicator": "IPCA",
    "variation": "YTD"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Has indicatorLatest", function() {
    const data = res.getBody();
    expect(data.data.indicatorLatest).to.be.an('object');
  });
}
