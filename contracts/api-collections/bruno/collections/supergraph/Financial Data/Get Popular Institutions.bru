meta {
  name: Get Popular Institutions
  type: graphql
  seq: 13
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query GetPopularInstitutions($anoMes: String) {
    popularInstitutions(anoMes: $anoMes) {
      rank
      shortDescription
      institution {
        id
        name
        legalName
        tradeName
        bacenInstitutionType
        institutionType
        tipoConsolidadoBancario
        dataRestriction {
          isRestricted
          reason
        }
      }
      popularInstitutionTopMetrics {
        metric
        popularInstitutionTopMetricItem {
          rank
          metricValue
          institution {
            id
            name
            dataRestriction {
              isRestricted
              reason
            }
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "anoMes": null
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Has popular institutions list", function() {
    const data = res.getBody();
    expect(data.data.popularInstitutions).to.be.an('array');
  });

  test("Popular institutions item has top metrics when present", function() {
    const data = res.getBody();
    const items = data.data.popularInstitutions;
    if (items.length > 0) {
      expect(items[0].popularInstitutionTopMetrics).to.be.an('array');
    }
  });
}
