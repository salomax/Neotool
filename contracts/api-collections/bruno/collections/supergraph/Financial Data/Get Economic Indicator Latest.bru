meta {
  name: Get Economic Indicator Latest
  type: graphql
  seq: 11
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query EconomicIndicatorsLatest($indicatorLabel: String,  $variationLabel: String) {
    economicIndicators(label: $indicatorLabel) {
      label
      variations(label: $variationLabel) {
        label
        series(limit: 1) {
          unit
          values {
            referenceDate
            value
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "indicatorLabel": "CDI",
    "variationLabel": "ROLLING_12M"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Has economicIndicators array", function() {
    const data = res.getBody();
    expect(data.data.economicIndicators).to.be.an('array');
  });
  
  test("Each item has required fields", function() {
    const data = res.getBody();
    const items = data.data.economicIndicators;
    if (items.length > 0) {
      const item = items[0];
      expect(item).to.have.property('label');
      expect(item).to.have.property('variations');
    }
  });
}
