meta {
  name: Add Service Account Credential
  type: http
  seq: 33
}

post {
  url: {{security_host}}/api/internal/services/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "serviceId": "service-test-asset",
    "permissions": []
  }
}

tests {
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("capture service credentials", function() {
    const data = res.getBody();

    expect(data.serviceId).to.be.a("string");
    expect(data.principalId).to.be.a("string");
    expect(data.clientSecret).to.be.a("string");

    bru.setVar("service_client_id", data.serviceId);
    bru.setVar("service_client_secret", data.clientSecret);
  });
}

settings {
  encodeUrl: false
  timeout: 0
}
