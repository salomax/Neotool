meta {
  name: Chat (Mutation)
  type: graphql
  seq: 1
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  mutation Chat($input: ChatInput!) {
    chat(input: $input) {
      sessionId
      response
      escalate
      conversation {
        sessionId
        status
        escalationReason
        messageCount
        lastMessage
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "sessionId": "assistant-session-001",
      "message": "Hi!"
    }
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
