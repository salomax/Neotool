meta {
  name: Clear Conversation
  type: graphql
  seq: 3
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  mutation ClearConversation($sessionId: String!) {
    clearConversation(sessionId: $sessionId)
  }
}

body:graphql:vars {
  {
    "sessionId": "assistant-session-001"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
