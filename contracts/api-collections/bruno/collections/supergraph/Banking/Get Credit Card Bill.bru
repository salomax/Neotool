meta {
  name: Get Credit Card Bill
  type: graphql
  seq: 21
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query CreditCardBill($financialAccountId: ID!, $closingDate: Date) {
    creditCardBill(financialAccountId: $financialAccountId, closingDate: $closingDate) {
      id
      financialAccountId
      closingDate
      dueDate
      totalAmount
      minimumPayment
      status
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "financialAccountId": "<card-account-id>",
    "closingDate": null
  }
}

