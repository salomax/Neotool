meta {
  name: List Investment Holdings
  type: graphql
  seq: 2
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query InvestmentHoldings($financialAccountId: ID) {
    investmentHoldings(financialAccountId: $financialAccountId) {
      id
      financialAccountId
      quantity
      averageCost
      source
      financialAccount {
        id
        name
      }
      asset {
        id
        ticker
        isinCode
        name
        assetType
        currencyCode
        priceFactor
      }
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "financialAccountId": "{{investment_account_id}}"
  }
}

script:post-response {
  const body = res.getBody();
  const firstHolding = body?.data?.investmentHoldings?.[0];
  if (firstHolding?.id) {
    bru.setEnvVar("investment_holding_id", firstHolding.id, { persist: true });
  }
  if (firstHolding?.asset?.id) {
    bru.setEnvVar("investment_asset_id", firstHolding.asset.id, { persist: true });
  }
}
