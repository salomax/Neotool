meta {
  name: Trigger Portfolio Recalculation
  type: graphql
  seq: 5
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  mutation TriggerPortfolioRecalculation {
    triggerPortfolioRecalculation(
      financialAccountId: null
      recalculateFrom: "2025-01-01"
    )
  }
  
}

body:graphql:vars {
  {
    "recalculateFrom": "2025-01-01"
  }
}
