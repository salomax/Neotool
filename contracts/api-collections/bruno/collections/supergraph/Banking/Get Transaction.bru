meta {
  name: Get Transaction
  type: graphql
  seq: 5
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query Transaction($id: ID!) {
    transaction(id: $id) {
      id
      financialAccountId
      belongsToUserId
      belongsToName
      creditDebitType
      type
      status
      source
      amount
      currencyCode
      amountBrl
      date
      description
      notes
      tags
      category {
        id
        name
        applicableTo
      }
      counterpartyName
      counterpartyDocument
      transferPeerTransactionId
      installmentNumber
      totalInstallments
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-0000-0000-000000000000"
  }
}
