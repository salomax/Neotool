meta {
  name: Create Transaction
  type: graphql
  seq: 7
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  mutation CreateTransaction($input: CreateTransactionInput!) {
    createTransaction(input: $input) {
      id
      financialAccountId
      belongsToUserId
      belongsToName
      creditDebitType
      type
      status
      amount
      currencyCode
      date
      description
      notes
      tags
      category {
        id
        name
      }
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "financialAccountId": "00000000-0000-0000-0000-000000000000",
      "creditDebitType": "DEBIT",
      "type": "PIX",
      "amount": 100.50,
      "date": "2025-02-27",
      "description": "Test transaction",
      "status": "POSTED",
      "currencyCode": "BRL",
      "belongsToName": "Casa",
      "tags": ["Mercado", "Familia"]
    }
  }
}
