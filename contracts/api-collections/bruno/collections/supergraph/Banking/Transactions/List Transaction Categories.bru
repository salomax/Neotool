meta {
  name: List Transaction Categories
  type: graphql
  seq: 5
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query TransactionCategories {
    transactionCategories {
      id
      parentId
      name
      applicableTo
      icon
      color
      isSystem
      sortOrder
    }
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Has transactionCategories array", function() {
    const data = res.getBody();
    expect(data.data).to.have.property("transactionCategories");
    expect(data.data.transactionCategories).to.be.an("array");
  });
}
