meta {
  name: List Transactions By Bill
  type: graphql
  seq: 6
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query TransactionsByBill(
    $billId: ID!
    $first: Int
    $after: String
  ) {
    transactions(
      billId: $billId
      first: $first
      after: $after
    ) {
      edges {
        node {
          id
          financialAccountId
          creditDebitType
          type
          status
          source
          amount
          currencyCode
          amountBrl
          date
          description
          notes
          category {
            id
            name
          }
        }
        cursor
      }
      pageInfo {
        hasNextPage
        hasPreviousPage
        startCursor
        endCursor
      }
      totalCount
    }
  }
}

body:graphql:vars {
  {
    "billId": "<bill-id>",
    "first": 50,
    "after": null
  }
}
