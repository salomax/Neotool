meta {
  name: Get PDF Import Job
  type: graphql
  seq: 18
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query PdfImportJob($jobId: ID!) {
    pdfImportJob(jobId: $jobId) {
      id
      status
      fileName
      createdAt
      errorMessage
      errorCode
      errorParameters
      reviewPayload {
        bankName
        extractionConfidence
        needsReview
        warnings
        statementPeriod {
          from
          to
        }
        cards {
          lastFourDigits
          matchedFinancialAccountId
          matchAmbiguous
          matchCandidates {
            id
            name
          }
          declaredTotal
          computedTotal
          totalMatchesDeclared
          transactions {
            date
            description
            amount
            creditDebitType
            confidence
            installment {
              current
              total
            }
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "jobId": "{{pdf_import_job_id}}"
  }
}
