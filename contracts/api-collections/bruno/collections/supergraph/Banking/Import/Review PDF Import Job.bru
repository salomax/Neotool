meta {
  name: Review PDF Import Job
  type: graphql
  seq: 13
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query ReviewPDFImportJob($jobId: ID!) {
    pdfImportJob(jobId: $jobId) {
      id
      status
      reviewPayload {
        needsReview
        warnings
        cards {
          lastFourDigits
          matchedFinancialAccountId
          matchAmbiguous
          matchCandidates { id name }
          totalMatchesDeclared
          transactions {
            date
            description
            amount
            creditDebitType
            confidence
            installment { current total }
          }
        }
      }
      errorMessage
      errorCode
      errorParameters
    }
  }
}

body:graphql:vars {
  {
    "jobId": "{{pdf_import_job_id}}"
  }
}
