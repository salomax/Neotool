meta {
  name: Submit PDF Bill Import
  type: graphql
  seq: 24
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  mutation SubmitPdfBillImport($input: SubmitPdfBillImportInput!) {
    submitPdfBillImport(input: $input) {
      id
      status
      fileName
      createdAt
      errorMessage
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "financialAccountId": "{{financial_account_id}}",
      "fileName": "bruno-pdf-bill.pdf",
      "fileBase64": "JVBERi0xLjcKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyA+PgplbmRvYmoKdHJhaWxlcgo8PCAvUm9vdCAxIDAgUiA+PgolJUVPRgo="
    }
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.submitPdfBillImport && body.data.submitPdfBillImport.id) {
    bru.setEnvVar("pdf_import_job_id", body.data.submitPdfBillImport.id, { persist: true });
  }
}
