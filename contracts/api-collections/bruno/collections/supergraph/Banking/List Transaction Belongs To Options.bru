meta {
  name: List Transaction Belongs To Options
  type: graphql
  seq: 12
}

post {
  url: {{router}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:graphql {
  query TransactionBelongsToOptions {
    transactionBelongsToOptions {
      belongsToUserId
      belongsToName
    }
  }
}
