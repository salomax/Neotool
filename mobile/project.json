{
  "name": "neotool-mobile",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "mobile",
  "projectType": "application",
  "implicitDependencies": ["shared-graphql"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm typecheck",
        "cwd": "mobile"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "mobile"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "mobile"
      }
    }
  },
  "tags": ["type:app", "lang:typescript", "scope:mobile"]
}
