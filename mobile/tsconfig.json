{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["jest", "react", "react-native"],
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/features/*": ["./src/features/*"],
      "@/entities/*": ["./src/entities/*"],
      "@/components/*": ["./src/shared/components/*"],
      "@/hooks/*": ["./src/shared/hooks/*"],
      "@/providers/*": ["./src/shared/providers/*"],
      "@/utils/*": ["./src/shared/utils/*"],
      "@/config/*": ["./src/shared/config/*"],
      "@/theme/*": ["./src/shared/theme/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/generated/*": ["./src/generated/*"],
      "@/assets/*": ["./assets/*"],
      "@invistus/shared-graphql": ["../libs/shared-graphql/src/index.ts"],
      "graphql": ["./node_modules/graphql"],
      "@graphql-typed-document-node/core": ["./node_modules/@graphql-typed-document-node/core"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
