        receita_data = {
            "alias": "EXAMPLE COMPANY",
        }
        result = extract_website_from_receita_data(receita_data, None)

        assert result == "https://examplecompany.com.br"

    def test_trade_name_fallback_strips_whitespace(self):
        """Test that trade_name fallback strips whitespace."""
        receita_data = {
            "alias": "  Example Company  ",
        }
        result = extract_website_from_receita_data(receita_data, None)

        assert result == "https://examplecompany.com.br"

    def test_trade_name_fallback_not_used_when_domain_exists(self):
        """Test that trade_name fallback is not used when domain exists."""
        receita_data = {
            "alias": "Example Company",
        }
        result = extract_website_from_receita_data(receita_data, "example.com")

        # Should use domain, not trade_name
        assert result == "https://example.com"

    def test_trade_name_fallback_not_used_when_alias_is_none(self):
        """Test that trade_name fallback is not used when alias is None."""
        receita_data = {
            "alias": None,
        }
        result = extract_website_from_receita_data(receita_data, None)

        assert result is None

    def test_trade_name_fallback_not_used_when_alias_is_empty_string(self):
        """Test that trade_name fallback is not used when alias is empty string."""
        receita_data = {
            "alias": "",
        }
        result = extract_website_from_receita_data(receita_data, None)

        assert result is None

    def test_trade_name_fallback_not_used_when_alias_is_whitespace_only(self):
        """Test that trade_name fallback is not used when alias is whitespace only."""
        receita_data = {
            "alias": "   ",
        }
        result = extract_website_from_receita_data(receita_data, None)

        assert result is None

    def test_trade_name_fallback_priority_after_special_rules(self):
        """Test that special rules take priority over trade_name fallback."""
        receita_data = {
            "alias": "Cresol Example",
        }
        result = extract_website_from_receita_data(receita_data, None)

        # Should use Cresol rule, not trade_name fallback
        assert result == "https://cresol.com.br"

    def test_trade_name_fallback_priority_after_api_response_fields(self):
        """Test that API response website fields take priority over trade_name fallback."""
        receita_data = {
            "alias": "Example Company",
            "website": "https://actual-website.com",
        }
        result = extract_website_from_receita_data(receita_data, None)

        # Should use website field, not trade_name fallback
        assert result == "https://actual-website.com"

    def test_trade_name_fallback_with_special_characters(self):
        """Test that trade_name fallback handles special characters."""
        receita_data = {
            "alias": "Example & Company LTDA",
        }
        result = extract_website_from_receita_data(receita_data, None)

        # Should remove spaces but keep special characters (validation will catch invalid domains)
        assert result == "https://example&companyltda.com.br"

    def test_trade_name_fallback_with_mixed_case(self):
        """Test that trade_name fallback handles mixed case correctly."""
        receita_data = {
            "alias": "ExAmPlE CoMpAnY",
        }
        result = extract_website_from_receita_data(receita_data, None)

        assert result == "https://examplecompany.com.br"


# ============================================================================
# Unit Tests - get_parent_cnpj
# ============================================================================


class TestGetParentCnpj:
    """Test get_parent_cnpj function."""

    def test_uses_cnpj_instituicao_lider_when_available(self):
        """Test that cnpj_instituicao_lider is used when available."""
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
            cnpj_instituicao_lider="11222333000181",
        )

        result = get_parent_cnpj(message)

        assert result == "11222333000181"
        # Should use leader CNPJ, not construct from bacen_cod_inst

    def test_constructs_cnpj_from_bacen_cod_inst_when_no_leader(self):
        """Test that CNPJ is constructed from bacen_cod_inst when no leader."""
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
            cnpj_instituicao_lider=None,
        )

        result = get_parent_cnpj(message)

        assert result is not None
        assert len(result) == 14
        assert result.startswith("608725040001")
        # Should construct CNPJ from bacen_cod_inst

    def test_raises_value_error_when_construction_fails(self):
        """Test that ValueError is raised when CNPJ construction fails."""
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="",  # Empty string will fail construction
            change_type="CREATED",
            cnpj_instituicao_lider=None,
        )

        with pytest.raises(ValueError, match="Cannot construct CNPJ from bacen_cod_inst"):
            get_parent_cnpj(message)

    def test_raises_value_error_when_invalid_bacen_cod_inst(self):
        """Test that ValueError is raised for invalid bacen_cod_inst."""
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="ABC",  # Invalid, no digits
            change_type="CREATED",
            cnpj_instituicao_lider=None,
        )

        with pytest.raises(ValueError, match="Cannot construct CNPJ from bacen_cod_inst"):
            get_parent_cnpj(message)

    def test_prioritizes_leader_over_construction(self):
        """Test that leader CNPJ is prioritized even if bacen_cod_inst is valid."""
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
            cnpj_instituicao_lider="99999999999999",  # Different from constructed
        )

        result = get_parent_cnpj(message)

        assert result == "99999999999999"
        # Should use leader, not construct


# ============================================================================
# Unit Tests - process_message (with mocked dependencies)
# ============================================================================


class TestProcessMessage:
    """Test process_message function with mocked dependencies."""

    @patch("tasks.processor.get_db_connection")
    @patch("tasks.processor.query_cnpja")
    @patch("tasks.processor.validate_website_reachable")
    @patch("tasks.processor.scrape_social_networks")
    def test_successful_processing_with_domain_extraction(
        self, mock_scrape_social_networks, mock_validate_website_reachable, mock_query_cnpja, mock_get_db_connection
    ):
        """Test successful processing with domain extraction."""
        # Arrange
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
        )

        # Mock CNPJá API response
        mock_query_cnpja.return_value = {
            "found": True,
            "error": None,
            "data": {
                "cnpj": "60872504000123",
                "name": "Test Institution",
                "emails": [{"domain": "example.com"}],
            },
        }

        # Mock website validation and social network scraping
        mock_validate_website_reachable.return_value = True
        mock_scrape_social_networks.return_value = None

        # Mock database
        mock_conn = MagicMock()
        mock_cursor = MagicMock()
        mock_cursor.__enter__ = Mock(return_value=mock_cursor)
        mock_cursor.__exit__ = Mock(return_value=None)
        mock_conn.cursor.return_value = mock_cursor
        mock_get_db_connection.return_value = mock_conn

        # Act
        result = process_message(message)

        # Assert
        assert result["success"] is True
        assert result["parent_cnpj"] is not None
        assert result["domain"] == "example.com"
        assert result["error"] is None

        # Verify database was called
        mock_cursor.execute.assert_called_once()
        mock_conn.commit.assert_called_once()
        # Connection is returned to pool, not closed (connection pooling)

        # Verify CNPJá API was called
        mock_query_cnpja.assert_called_once()
        
        # Verify website validation was called (website would be constructed from domain)
        mock_validate_website_reachable.assert_called_once()

    @patch("tasks.processor.get_db_connection")
    @patch("tasks.processor.query_cnpja")
    def test_successful_processing_without_domain_404_from_api(
        self, mock_query_cnpja, mock_get_db_connection
    ):
        """Test successful processing without domain (404 from API)."""
        # Arrange
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
        )

        # Mock CNPJá API 404 response
        mock_query_cnpja.return_value = {
            "found": False,
            "error": None,
            "data": None,
        }

        # Mock database
        mock_conn = MagicMock()
        mock_cursor = MagicMock()
        mock_cursor.__enter__ = Mock(return_value=mock_cursor)
        mock_cursor.__exit__ = Mock(return_value=None)
        mock_conn.cursor.return_value = mock_cursor
        mock_get_db_connection.return_value = mock_conn

        # Act
        result = process_message(message)

        # Assert
        assert result["success"] is True
        assert result["parent_cnpj"] is not None
        assert result["domain"] is None  # No domain from 404
        assert result["error"] is None

        # Verify database was still called (with null domain)
        mock_cursor.execute.assert_called_once()
        mock_conn.commit.assert_called_once()

    @patch("tasks.processor.query_cnpja")
    def test_api_error_handling_returns_error_result(self, mock_query_cnpja):
        """Test API error handling returns error result."""
        # Arrange
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
        )

        # Mock CNPJá API error
        mock_query_cnpja.return_value = {
            "found": None,
            "error": "Request timeout",
            "data": None,
        }

        # Act
        result = process_message(message)

        # Assert
        assert result["success"] is False
        assert result["parent_cnpj"] is not None
        assert result["domain"] is None
        assert result["error"] == "Request timeout"

    @patch("tasks.processor.get_db_connection")
    @patch("tasks.processor.query_cnpja")
    def test_database_connection_error_raises_exception(
        self, mock_query_cnpja, mock_get_db_connection
    ):
        """Test database connection error raises exception."""
        # Arrange
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
        )

        # Mock CNPJá API success
        mock_query_cnpja.return_value = {
            "found": True,
            "error": None,
            "data": {"emails": [{"domain": "example.com"}]},
        }

        # Mock database connection error
        mock_get_db_connection.side_effect = psycopg2.OperationalError("Connection failed")

        # Act & Assert
        with pytest.raises(psycopg2.OperationalError, match="Connection failed"):
            process_message(message)

    @patch("tasks.processor.get_db_connection")
    @patch("tasks.processor.query_cnpja")
    def test_database_insert_error_raises_exception(
        self, mock_query_cnpja, mock_get_db_connection
    ):
        """Test database insert error raises exception."""
        # Arrange
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
        )

        # Mock CNPJá API success
        mock_query_cnpja.return_value = {
            "found": True,
            "error": None,
            "data": {"emails": [{"domain": "example.com"}]},
        }

        # Mock database
        mock_conn = MagicMock()
        mock_cursor = MagicMock()
        mock_cursor.__enter__ = Mock(return_value=mock_cursor)
        mock_cursor.__exit__ = Mock(return_value=None)
        mock_cursor.execute.side_effect = psycopg2.DatabaseError("Database error")
        mock_conn.cursor.return_value = mock_cursor
        mock_get_db_connection.return_value = mock_conn

        # Act & Assert
        with pytest.raises(psycopg2.DatabaseError, match="Database error"):
            process_message(message)

        # Verify rollback was called
        mock_conn.rollback.assert_called_once()
        # Connection is returned to pool, not closed (connection pooling)

    def test_message_validation_error_raises_value_error(self):
        """Test message validation error raises ValueError."""
        # Arrange: Invalid message (missing bacen_cod_inst)
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="",  # Invalid: empty
            change_type="CREATED",
        )

        # Act & Assert
        with pytest.raises(ValueError, match="bacen_cod_inst is required"):
            process_message(message)

    def test_invalid_change_type_raises_value_error(self):
        """Test invalid change_type raises ValueError."""
        # Arrange: Invalid change_type
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="INVALID",  # Invalid change_type
        )

        # Act & Assert
        with pytest.raises(ValueError, match="Invalid change_type"):
            process_message(message)

    @patch("tasks.processor.get_db_connection")
    @patch("tasks.processor.query_cnpja")
    @patch("tasks.processor.validate_website_reachable")
    @patch("tasks.processor.scrape_social_networks")
    def test_idempotency_on_conflict_updates_existing_record(
        self, mock_scrape_social_networks, mock_validate_website_reachable, mock_query_cnpja, mock_get_db_connection
    ):
        """Test that ON CONFLICT updates existing record (idempotency)."""
        # Arrange
        message = InstitutionUpsertedMessage(
            schema_version="1.0",
            event_id="test-123",
            occurred_at="2024-01-01T00:00:00Z",
            source="test",
            bacen_cod_inst="60872504",
            change_type="CREATED",
        )

        # Mock CNPJá API response
        mock_query_cnpja.return_value = {
            "found": True,
            "error": None,
            "data": {
                "emails": [{"domain": "example.com"}],
            },
        }

        # Mock website validation and social network scraping
        mock_validate_website_reachable.return_value = True
        mock_scrape_social_networks.return_value = None

        # Mock database
        mock_conn = MagicMock()
        mock_cursor = MagicMock()
        mock_cursor.__enter__ = Mock(return_value=mock_cursor)
        mock_cursor.__exit__ = Mock(return_value=None)
        mock_conn.cursor.return_value = mock_cursor
        mock_get_db_connection.return_value = mock_conn

        # Act
        result = process_message(message)

        # Assert
        assert result["success"] is True

        # Verify SQL includes ON CONFLICT clause
        execute_call = mock_cursor.execute.call_args[0][0]
        assert "ON CONFLICT" in execute_call.upper()
        assert "DO UPDATE SET" in execute_call.upper()

