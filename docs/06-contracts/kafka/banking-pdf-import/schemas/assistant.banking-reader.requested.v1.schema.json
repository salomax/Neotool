{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invistus/schemas/kafka/assistant.banking-reader.requested.v1.schema.json",
  "title": "assistant.banking-reader.requested.v1",
  "description": "Canonical request event sent from banking to assistant when deterministic parsing cannot handle a document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "document_type",
    "file_type",
    "account_type",
    "extracted_text",
    "extraction_metadata",
    "callback_context"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "CREDIT_CARD_BILL",
        "BANK_STATEMENT",
        "INVESTMENT_IR_REPORT"
      ]
    },
    "file_type": {
      "type": "string",
      "enum": [
        "PDF",
        "XLSX",
        "XLS"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "BANK",
        "CREDIT",
        "PAYMENT",
        "CASH",
        "INVESTMENT",
        "LOAN",
        "ASSET"
      ]
    },
    "source_topic": {
      "type": "string",
      "description": "Optional source topic used for traceability, usually pdf-extractor.extracted."
    },
    "extracted_text": {
      "type": "string",
      "minLength": 1
    },
    "extraction_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "callback_context": {
      "$ref": "#/$defs/callback_context"
    }
  },
  "$defs": {
    "callback_context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "job_id",
        "account_id",
        "user_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
