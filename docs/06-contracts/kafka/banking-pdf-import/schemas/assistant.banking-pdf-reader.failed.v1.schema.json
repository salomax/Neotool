{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invistus/schemas/kafka/assistant.banking-pdf-reader.failed.v1.schema.json",
  "title": "assistant.banking-pdf-reader.failed.v1",
  "description": "Canonical failure event emitted by assistant when banking PDF reading fails.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "document_type",
    "error",
    "error_metadata",
    "callback_context"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "CREDIT_CARD_BILL",
        "BANK_STATEMENT",
        "INVESTMENT_IR_REPORT"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_PAYLOAD",
            "UNSUPPORTED_DOCUMENT_TYPE",
            "PROMPT_RESOLUTION_ERROR",
            "LLM_TIMEOUT",
            "LLM_PROVIDER_ERROR",
            "LLM_NON_JSON",
            "SCHEMA_VALIDATION_FAILED",
            "EMPTY_OUTPUT"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "error_metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "processor_type",
        "stage"
      ],
      "properties": {
        "processor_type": {
          "type": "string",
          "const": "LLM"
        },
        "stage": {
          "type": "string",
          "enum": [
            "CONSUME",
            "PROMPT_SELECTION",
            "LLM_CALL",
            "OUTPUT_VALIDATION",
            "PUBLISH"
          ]
        },
        "reader_id": {
          "type": "string"
        },
        "model_provider": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "callback_context": {
      "$ref": "#/$defs/callback_context"
    }
  },
  "$defs": {
    "callback_context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "job_id",
        "account_id",
        "user_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
