{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invistus/schemas/kafka/assistant.banking-pdf-reader.done.v1.schema.json",
  "title": "assistant.banking-pdf-reader.done.v1",
  "description": "Canonical success event emitted by assistant after reading banking PDF content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "document_type",
    "llm_output",
    "parse_metadata",
    "callback_context"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "CREDIT_CARD_BILL",
        "BANK_STATEMENT"
      ]
    },
    "llm_output": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "bank_name",
        "statement_period",
        "cards",
        "extraction_confidence",
        "needs_review",
        "warnings"
      ],
      "properties": {
        "bank_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement_period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "extraction_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "parse_metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "processor_type",
        "reader_id",
        "confidence"
      ],
      "properties": {
        "processor_type": {
          "type": "string",
          "const": "LLM"
        },
        "reader_id": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model_provider": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "callback_context": {
      "$ref": "#/$defs/callback_context"
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "last_four_digits",
        "closing_date",
        "due_date",
        "declared_total",
        "computed_total",
        "total_matches_declared",
        "transactions",
        "confidence"
      ],
      "properties": {
        "last_four_digits": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "holder_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "closing_date": {
          "type": "string",
          "format": "date"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "declared_total": {
          "type": "number"
        },
        "computed_total": {
          "type": "number"
        },
        "total_matches_declared": {
          "type": "boolean"
        },
        "transactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transaction"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "date",
        "description",
        "amount",
        "credit_debit_type",
        "confidence"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number"
        },
        "credit_debit_type": {
          "type": "string",
          "enum": [
            "DEBIT",
            "CREDIT"
          ]
        },
        "installment": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "current",
            "total"
          ],
          "properties": {
            "current": {
              "type": "integer",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "callback_context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "job_id",
        "account_id",
        "user_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
