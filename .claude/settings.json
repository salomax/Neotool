{
  "permissions": {
    "allow": [
      "Bash(gh workflow *)",
      "Bash(gh run *)",
      "Bash(gh pr *)",
      "Bash(git rebase *)",
      "Bash(kubectl rollout *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
