# ============================================================================
# Banking GraphQL Schema
#
# Handles banking features including account management, transactions,
# and financial operations.
# ============================================================================

# External type reference — Asset is defined in the assets subgraph.
type Asset @key(fields: "id") {
  id: ID!
}

# ============================================================================
# Issuer
# ============================================================================

"""
Financial institution associated with an account.
"""
type Issuer {
  id: ID!
  name: String!
  domain: String
  compeCode: String
  ispb: String
  countryCode: String!
  logoKey: String
  category: IssuerCategory!
  logoAsset: Asset
}

# ============================================================================
# Enums
# ============================================================================

enum FinancialAccountType {
  BANK
  CREDIT
  PAYMENT
  CASH
  INVESTMENT
  LOAN
  ASSET
  BENEFIT
}

enum FinancialAccountSubtype {
  # Bank account subtypes
  CONTA_CORRENTE
  CONTA_POUPANCA
  CONTA_SALARIO
  CONTA_DIGITAL
  CONTA_CONJUNTA
  # Card subtypes
  CREDIT_CARD
  CHARGE_CARD
  PREPAID_CARD
  VOUCHER_CARD
  # Other
  WALLET
  BROKERAGE
  FIXED_INCOME
  PENSION
  CRYPTO
  PERSONAL_LOAN
  MORTGAGE
  AUTO_LOAN
  PROPERTY
  VEHICLE
  OTHER_ASSET
  # Benefit subtypes (government-managed, institution: Caixa Econômica Federal)
  FGTS
  INSS
}

enum CreditCardNetwork {
  VISA
  MASTERCARD
  AMERICAN_EXPRESS
  DINERS_CLUB
  HIPERCARD
  ELO
  BANDEIRA_PROPRIA
  OUTRAS
}

enum CreditCardLevel {
  STANDARD
  GOLD
  PLATINUM
  INFINITE
  BLACK
}

enum ConnectionStatus {
  CONNECTED
  SYNCING
  DISCONNECTED
  ERROR
  CONSENT_EXPIRING
  CONSENT_EXPIRED
}

enum IssuerCategory {
  BANK
  BROKERAGE
  CRYPTO_EXCHANGE
  PAYMENT
  BENEFIT
}

# ============================================================================
# Transaction enums
# ============================================================================

"""
Direction of money flow.
Amount is always positive; direction is carried here.
"""
enum CreditDebitType {
  CREDIT
  DEBIT
}

"""
Transaction type (OFB-aligned).
BALANCE_ADJUSTMENT is neutral — used for opening balance and reconciliation.
"""
enum TransactionType {
  # Payment types (OFB-aligned)
  PIX
  TED
  DOC
  BOLETO
  TRANSFER
  BILL_PAYMENT
  # Income types
  SALARY
  DEPOSIT
  CASHBACK
  INVESTMENT_RETURN
  OTHER_INCOME
  # Expense types
  CARD
  WITHDRAWAL
  FEE
  INTEREST
  LOAN_PAYMENT
  TAX
  OTHER_EXPENSE
  # Neutral
  BALANCE_ADJUSTMENT
}

"""
Lifecycle status of a transaction.
FUTURE = manually scheduled; excluded from current balance but included in projected balance.
"""
enum TransactionStatus {
  POSTED
  PENDING
  FUTURE
}

"""
How the transaction entered the system.
"""
enum TransactionSource {
  MANUAL
  OPEN_FINANCE
  OFX
  CSV
  PDF
  NFC_E
  RECEIPT_OCR
  """ @deprecated — legacy values kept for backward compatibility """
  PLUGGY
  PDF_BILL
}

"""How the transaction's category was assigned. Null when uncategorized."""
enum CategorySource {
  MANUAL
  RULE
  IMPORTED
  AI
}

"""
Category applicability (income, expense, transfer, or any).
"""
enum CategoryApplicableTo {
  INCOME
  EXPENSE
  TRANSFER
  ANY
}

"""Pattern type for transaction rule description matching."""
enum PatternType {
  CONTAINS
  STARTS_WITH
  EXACT
  REGEX
}

enum ImportSource {
  AUTO
  OFX
  CSV_AUTO
  CSV_NUBANK
  CSV_ITAU
  CSV_BRADESCO
  CSV_SANTANDER
  NFC_E
  RECEIPT_OCR
  OPEN_FINANCE
  PLUGGY
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
  REVIEW_CANCELLED
}

enum BillImportJobStatus {
  PENDING
  EXTRACTING
  EXTRACTED
  LLM_PROCESSING
  AWAITING_REVIEW
  IMPORTING
  DONE
  FAILED
}

enum ImportType {
  CREDIT_CARD_BILL
  BANK_STATEMENT
}

"""
User resolution for a duplicate candidate (incoming row vs existing transaction(s)).
"""
enum DuplicateResolution {
  KEEP_BOTH
  USE_INCOMING
  KEEP_EXISTING
}

# ============================================================================
# Financial Account Types
# ============================================================================

"""
Bank-specific data. Present only when type = BANK.
"""
type BankAccountData {
  branchCode: String
  number: String
  checkDigit: String
  maskedNumber: String
}

"""
Card-specific data. Present only when subtype is CREDIT_CARD, PREPAID_CARD, CHARGE_CARD, or VOUCHER_CARD.
closingDay and dueDay are optional billing-cycle metadata when known.
"""
type CardData {
  maskedNumber: String
  bin: String
  cardNetwork: CreditCardNetwork
  cardLevel: CreditCardLevel
  creditLimit: Float
  availableCreditLimit: Float
  minimumPaymentPercentage: Float
  closingDay: Int
  dueDay: Int
  """Optional bank account that will receive the debit leg of bill-payment transfers."""
  linkedBankAccountId: ID
  """When true, this account represents multiple/virtual cards with no specific last-4."""
  isMultiCard: Boolean!
}

type YearMonth {
  year: Int!
  month: Int!
}

"""
A personal finance account or card belonging to the authenticated user's account.
The tenant association is resolved from the JWT and is not exposed directly.
"""
type FinancialAccount {
  id: ID!
  type: FinancialAccountType!
  subtype: FinancialAccountSubtype!
  name: String!
  currencyCode: String!
  includeInNetWorth: Boolean!
  includeInDashboard: Boolean!
  """When true, idle cash on this custodian account counts toward allocation % in investments UI."""
  includeCashInAllocation: Boolean!
  themeColor: String
  """Linked issuer from the issuers seed list. Null when a custom institution is used."""
  issuer: Issuer
  """Custom institution name. Set when issuerId is null. Use issuer.name when issuer is present."""
  issuerName: String
  bankData: BankAccountData
  cardData: CardData
  """Open Finance connection status. Null for manually managed accounts."""
  connectionStatus: ConnectionStatus
  consentExpiresAt: DateTime
  lastSyncAt: DateTime
  """Earliest month with account data (transactions or investment portfolio snapshots)."""
  dataSince: YearMonth
  """
  Signed initial balance amount (positive = credit, negative = debit/overdraft).
  Null if no initial balance was set on this account.
  """
  initialBalance: Float
  """Reference date of the initial balance. Null when initialBalance is null."""
  initialBalanceDate: Date
  createdAt: DateTime!
  updatedAt: DateTime!
}

# ============================================================================
# Transactions
# ============================================================================

"""
A merchant (payee) associated with a transaction.
System merchants are shared across all accounts; user merchants are account-scoped.
"""
type Merchant {
  id: ID!
  name: String!
  domain: String
  sector: String
  isSystem: Boolean!
  isOwned: Boolean!
  """Logo asset via federation. Null until the hydration job has run for the domain."""
  logoAsset: Asset
}

type MerchantEdge {
  node: Merchant!
  cursor: String!
}

type MerchantConnection {
  edges: [MerchantEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

"""A top-merchant analytics row."""
type TopMerchant {
  merchant: Merchant!
  transactionCount: Int!
  totalAmount: Float!
  lastUsedAt: Date!
}

input CreateMerchantInput {
  name: String!
  website: String
  sector: String
}

"""
Category for classifying transactions (system + user-defined).
"""
type TransactionCategory {
  id: ID!
  parentId: ID
  name: String!
  applicableTo: CategoryApplicableTo!
  icon: String
  color: String
  isSystem: Boolean!
  sortOrder: Int!
}

input CreateCategoryInput {
  parentId: ID
  name: String!
  applicableTo: CategoryApplicableTo!
  icon: String
  color: String
  sortOrder: Int
}

input UpdateCategoryInput {
  name: String
  icon: String
  color: String
  sortOrder: Int
}

"""
Auto-assignment rule that maps a description pattern to a category and/or merchant.
Explicit or implicit.
"""
type TransactionRule {
  id: ID!
  categoryId: ID
  category: TransactionCategory
  merchantId: ID
  merchant: Merchant
  typeOverride: CategoryApplicableTo
  descriptionOverride: String
  tagsOverride: [String!]
  pattern: String!
  patternType: PatternType!
  applicableTo: CategoryApplicableTo!
  priority: Int!
  isSystem: Boolean!
  isDisabledForAccount: Boolean!
  isImplicit: Boolean!
  matchCount: Int!
  """1-based evaluation order position (same order used by the rule engine)."""
  position: Int!
  createdAt: DateTime!
}

"""Edge in a TransactionRuleConnection."""
type TransactionRuleEdge {
  node: TransactionRule!
  cursor: String!
}

"""Relay connection for paginated transaction rules."""
type TransactionRuleConnection {
  edges: [TransactionRuleEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type AppliedRuleHistoryEntry {
  ruleId: ID!
  appliedAt: DateTime!
}

input CreateTransactionRuleInput {
  categoryId: ID
  merchantId: ID
  typeOverride: CategoryApplicableTo
  descriptionOverride: String
  tagsOverride: [String!]
  pattern: String!
  patternType: PatternType!
  applicableTo: CategoryApplicableTo!
  priority: Int
}

input UpdateTransactionRuleInput {
  categoryId: ID
  merchantId: ID
  typeOverride: CategoryApplicableTo
  descriptionOverride: String
  tagsOverride: [String!]
  applicableTo: CategoryApplicableTo
  pattern: String
  patternType: PatternType
  priority: Int
}

"""
Core ledger transaction row.
"""
type Transaction {
  id: ID!
  financialAccountId: ID!
  belongsToUserId: ID
  belongsToName: String

  # Classification
  creditDebitType: CreditDebitType!
  type: TransactionType!
  status: TransactionStatus!
  source: TransactionSource!
  hasNfceDocument: Boolean!

  # Amount
  amount: Float!
  currencyCode: String!
  """BRL equivalent for FX transactions (null for BRL)."""
  amountBrl: Float

  # Dates
  date: Date!
  """Exact date-time of the transaction when provided (e.g. by Open Finance). Null when only date is known."""
  transactionDatetime: DateTime

  # Description
  description: String!
  notes: String
  tags: [String!]!

  # Category
  category: TransactionCategory
  """How the category was assigned. Null when uncategorized."""
  categorySource: CategorySource

  # Merchant
  merchant: Merchant

  # Counterparty (bank account transactions / PIX / TED)
  counterpartyName: String
  counterpartyDocument: String
  counterpartyBankCode: String
  counterpartyAccountNumber: String
  paymentReason: String

  # Transfer
  transferPeerTransactionId: ID
  """Set when this row is the cash leg linked to an investment transaction."""
  investmentTransactionId: ID
  """Optional link to a recurring payment template."""
  recurringPaymentId: ID
  """
  When [investmentTransactionId] is set, the underlying instrument for that event.
  Same shape as [InvestmentHolding.asset] (e.g. for cash-movement UI without N+1 client resolution).
  """
  linkedInvestmentAsset: InvestmentAsset

  # Installments
  installmentNumber: Int
  totalInstallments: Int

  # Card
  billId: ID
  cardIdentifier: String
  payeeMcc: Int
  billPostDate: Date
  """Distinct rule IDs that have been applied at least once to this transaction."""
  appliedRuleIds: [ID!]!
  """Audit history of rule applications for this transaction."""
  appliedRuleHistory: [AppliedRuleHistoryEntry!]!

  # Attachments (receipts, contracts, guarantees, etc.)
  attachments: [TransactionAttachment!]!

  # Audit
  createdAt: DateTime!
  updatedAt: DateTime!
}

"""
Monthly summary header for a financial account — entradas, saídas, saldo total.
Served from the monthly_balance_snapshots cache; transfer and projection fields are on-demand.
"""
type MonthSummary {
  year: Int!
  month: Int!
  """Entradas: total CREDIT excluding TRANSFER and BALANCE_ADJUSTMENT (POSTED/PENDING only)."""
  totalIncome: Float!
  """Saídas: total DEBIT excluding TRANSFER and BALANCE_ADJUSTMENT (POSTED/PENDING only)."""
  totalExpenses: Float!
  """Saldo total at month-end (includes all types, excludes FUTURE)."""
  closingBalance: Float!
  """Balance at start of month (prior month's closingBalance)."""
  openingBalance: Float!
  """Total CREDIT of type TRANSFER in the month."""
  transfersIn: Float!
  """Total DEBIT of type TRANSFER in the month."""
  transfersOut: Float!
  """closingBalance + FUTURE transactions. Null when no FUTURE transactions exist."""
  projectedClosingBalance: Float
  """True when (year, month) equals the current calendar month."""
  isCurrentMonth: Boolean!
  """True when (year, month) is strictly after today's month. All values are on-demand projections; no snapshot is persisted."""
  isFutureMonth: Boolean!
  """Top expense categories for the month (ordered by totalAmount DESC)."""
  expensesByCategory: [CategoryTotal!]!
  """Top income categories for the month (ordered by totalAmount DESC)."""
  incomeByCategory: [CategoryTotal!]!
  """Top tags for the month (ordered by totalAmount DESC)."""
  tagsSummary: [TagTotal!]!
}

"""
Single month data point for a cash-flow series (income vs expenses vs net).
"""
type CashFlowDataPoint {
  year: Int!
  month: Int!
  totalIncome: Float!
  totalExpenses: Float!
  """Net = totalIncome - totalExpenses."""
  net: Float!
  """Aggregate banking closing balance for the month."""
  closingBalance: Float!
}

"""
Aggregate summary across a date range (used by the dashboard period summary).
"""
type DashboardPeriodSummary {
  # ── Fluxo de caixa ──────────────────────────────────────────────────────
  totalIncome: Float!
  totalExpenses: Float!
  """net = totalIncome - totalExpenses"""
  net: Float!
  """Number of months in the selected range (used by frontend for averages)."""
  monthCount: Int!
  avgMonthlyIncome: Float!
  avgMonthlyExpenses: Float!
  """avgMonthlySavings = net / monthCount."""
  avgMonthlySavings: Float!
  """(net / totalIncome) × 100. Null when totalIncome = 0."""
  savingsRate: Float

  # ── Patrimônio ──────────────────────────────────────────────────────────
  """Closing cash balance of the last month (banking accounts, excl. transfers)."""
  closingCashBalance: Float!
  """Investment portfolio gross value at end of period."""
  closingPortfolioValue: Float!
  """closingCashBalance + closingPortfolioValue."""
  totalNetWorth: Float!

  # ── Investimentos ────────────────────────────────────────────────────────
  """Aligned with investments summary totalCostBasis (all-time holdings cost basis)."""
  totalInvested: Float!
  avgMonthlyInvested: Float!
  """Aligned with investments summary grossGain (all-time)."""
  totalReturn: Float!
  """Average monthly return amount (totalReturn / monthCount)."""
  avgMonthlyReturn: Float!
  """Investment portfolio gross value at start of period."""
  openingPortfolioValue: Float!
  """Aligned with investments summary performance.twr for ALL period, in percentage points."""
  returnPct: Float

  # ── Campos mantidos para compatibilidade ────────────────────────────────
  """Deprecated alias for closingCashBalance. Keep for frontend compatibility."""
  closingBalance: Float!
  """Opening balance of the first month in the range."""
  openingBalance: Float!
}

"""Monthly portfolio gross value snapshot for a date range (dashboard use)."""
type PortfolioMonthlyValue {
  year: Int!
  month: Int!
  """Market value of all positions. Does NOT include investment account cash balance."""
  grossValue: Float!
  """True when at least one holding used an estimated valuation for this month."""
  isEstimated: Boolean!
}

"""
Category total for a period (expense/income breakdown). Percentage of period total.
"""
type CategoryTotal {
  """Null when this row represents the special uncategorized bucket."""
  category: TransactionCategory
  """True when the row aggregates transactions with no category assigned."""
  uncategorized: Boolean!
  totalAmount: Float!
  transactionCount: Int!
  """Percentage of the period total (0–100)."""
  percentage: Float!
}

"""
Tag total for a period. Percentage of grouped tag total.
"""
type TagTotal {
  tag: String!
  totalAmount: Float!
  transactionCount: Int!
  """Percentage of the grouped tag total (0–100)."""
  percentage: Float!
}

"""
Lifecycle status of a credit card bill (fatura).
OPEN    → closingDate >= today (bill still accepting charges).
CLOSED  → closingDate < today and dueDate >= today (awaiting payment).
OVERDUE → dueDate < today and not yet paid.
PAID    → terminal state.
"""
enum BillStatus { OPEN CLOSED PAID OVERDUE }

"""
A monthly credit card bill (fatura) for a CREDIT_CARD or CHARGE_CARD account.
totalAmount is the net spend across all non-deleted transactions in the billing cycle:
  SUM(DEBIT amount) - SUM(CREDIT amount).
Bills are auto-created when the first transaction is recorded for a billing cycle.
"""
type CreditCardBill {
  id: ID!
  financialAccountId: ID!
  """Last day of the billing cycle (derived from CardData.closingDay)."""
  closingDate: Date!
  """Payment due date (derived from CardData.dueDay relative to closingDate)."""
  dueDate: Date!
  """Business bill month (first day of the due month). Used for identity and ordering."""
  referenceMonth: Date!
  """Net spend in the billing cycle (DEBIT - CREDIT). Zero until first transaction."""
  totalAmount: Float!
  """Minimum payment amount. Null until computed (Phase 5: Open Finance)."""
  minimumPayment: Float
  status: BillStatus!
  createdAt: DateTime!
  updatedAt: DateTime!
}

"""
Relay-style page info for paginated lists.
"""
type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

"""
Edge in a TransactionConnection.
"""
type TransactionEdge {
  node: Transaction!
  cursor: String!
}

"""
Relay connection for paginated transactions.
"""
type TransactionConnection {
  edges: [TransactionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

"""
Distinct attribution option (user or name tag) used by transactions in the account.
Exactly one field is expected to be non-null.
"""
type TransactionBelongsToOption {
  belongsToUserId: ID
  belongsToName: String
}

"""
Distinct tag already used in transactions for the authenticated account.
"""
type TransactionTagOption {
  tag: String!
}

type SimilarTransactionEditPreview {
  similarCount: Int!
  matchDescription: String!
  supportsFuturePropagation: Boolean!
}

type SimilarTransactionEditResult {
  affectedCount: Int!
  futureRuleCreated: Boolean!
}

# ============================================================================
# Input Types
# ============================================================================

input BankAccountDataInput {
  branchCode: String
  number: String
  checkDigit: String
  maskedNumber: String
}

input CardDataInput {
  maskedNumber: String
  bin: String
  cardNetwork: CreditCardNetwork
  cardLevel: CreditCardLevel
  """Optional billing-cycle limit metadata."""
  creditLimit: Float
  """Optional billing-cycle closing day when known."""
  closingDay: Int
  """Optional billing-cycle due day when known."""
  dueDay: Int
  """Optional bank account that will receive the debit leg of bill-payment transfers."""
  linkedBankAccountId: ID
  """Set to true to mark this account as an umbrella for multiple/virtual cards."""
  isMultiCard: Boolean
}

input CreateFinancialAccountInput {
  type: FinancialAccountType!
  subtype: FinancialAccountSubtype!
  """Display name. Defaults to issuer name when omitted."""
  name: String
  """ID from the issuers list. Mutually exclusive with issuerName."""
  issuerId: ID
  """Custom institution name. Required when issuerId is null."""
  issuerName: String
  themeColor: String
  """ISO 4217 currency code. Defaults to BRL."""
  currencyCode: String
  includeInNetWorth: Boolean
  includeInDashboard: Boolean
  includeCashInAllocation: Boolean
  """Required when type = BANK."""
  bankData: BankAccountDataInput
  """Required when subtype is CREDIT_CARD, CHARGE_CARD, PREPAID_CARD, or VOUCHER_CARD."""
  cardData: CardDataInput
  """Non-zero account balance on initialBalanceDate. Creates a BALANCE_ADJUSTMENT transaction automatically."""
  initialBalance: Float
  """Reference date for the initial balance. Required when initialBalance is provided."""
  initialBalanceDate: Date
}

input UpdateFinancialAccountInput {
  type: FinancialAccountType!
  subtype: FinancialAccountSubtype!
  name: String
  issuerId: ID
  issuerName: String
  themeColor: String
  currencyCode: String
  includeInNetWorth: Boolean
  includeInDashboard: Boolean
  includeCashInAllocation: Boolean
  bankData: BankAccountDataInput
  cardData: CardDataInput
  """
  Signed initial balance. Positive = credit (opening balance), negative = debit (overdraft).
  Non-zero when provided. Pass null to remove the existing initial balance.
  Only applicable to BANK accounts.
  """
  initialBalance: Float
  """Reference date for the initial balance. Required when initialBalance is provided."""
  initialBalanceDate: Date
}

"""
Input for creating a new manual transaction.
"""
input CreateTransactionInput {
  financialAccountId: ID!
  creditDebitType: CreditDebitType!
  type: TransactionType!
  amount: Float!
  date: Date!
  description: String!
  status: TransactionStatus
  currencyCode: String
  notes: String
  tags: [String!]
  categoryId: ID
  merchantId: ID
  belongsToUserId: ID
  belongsToName: String

  # Counterparty
  counterpartyName: String
  counterpartyDocument: String
  counterpartyBankCode: String
  counterpartyAccountNumber: String
  paymentReason: String

  # Installments
  installmentNumber: Int
  totalInstallments: Int

  # Card
  cardIdentifier: String
  payeeMcc: Int
}

"""
Input for updating an existing manual transaction.
All fields are optional and only provided fields are updated.
"""
input UpdateTransactionInput {
  creditDebitType: CreditDebitType
  type: TransactionType
  amount: Float
  date: Date
  description: String
  status: TransactionStatus
  notes: String
  tags: [String!]
  categoryId: ID
  merchantId: ID
  belongsToUserId: ID
  belongsToName: String

  # Counterparty
  counterpartyName: String
  counterpartyDocument: String
  counterpartyBankCode: String
  counterpartyAccountNumber: String
  paymentReason: String

  # Card
  cardIdentifier: String
  payeeMcc: Int
}

input ResolveImportDuplicateInput {
  jobId: ID!
  rowIndex: Int!
  resolution: DuplicateResolution!
}

input ImportTransactionsFileInput {
  financialAccountId: ID!
  fileName: String!
  source: ImportSource
  fileBase64: String!
}

input SubmitBillImportInput {
  importType: ImportType!
  financialAccountId: ID
  fileName: String!
  fileBase64: String!
  password: String
}

input ConfirmBillImportInput {
  jobId: ID!
  closingDate: Date
  dueDate: Date
  cards: [ConfirmBillReviewCardInput!]!
}

input ConfirmBillReviewCardInput {
  reviewCardId: ID!
  financialAccountId: ID!
  transactions: [ConfirmBillReviewTransactionInput!]!
}

input ConfirmBillReviewTransactionInput {
  date: Date!
  description: String!
  amount: Float!
  creditDebitType: CreditDebitType!
  include: Boolean!
  isBillPayment: Boolean
  installment: InstallmentInfoInput
  categoryId: ID
  categorySource: CategorySource
}

input InstallmentInfoInput {
  current: Int!
  total: Int!
}

# ============================================================================
# Transaction Import Types
# ============================================================================

type ParsedImportRow {
  creditDebitType: CreditDebitType!
  amount: Float!
  date: Date!
  description: String!
  currencyCode: String!
  counterpartyName: String
  counterpartyDocument: String
}

type ImportDuplicateCandidate {
  rowIndex: Int!
  parsed: ParsedImportRow!
  candidates: [Transaction!]!
}

type TransactionImport {
  id: ID!
  financialAccountId: ID!
  source: ImportSource!
  fileName: String
  status: ImportStatus!
  totalRows: Int
  importedCount: Int
  skippedCount: Int
  duplicateReviewCount: Int
  errorCount: Int
  errorDetails: String
  duplicateCandidates: [ImportDuplicateCandidate!]!
  dateFrom: Date
  dateTo: Date
  completedAt: DateTime
  createdAt: DateTime!
  updatedAt: DateTime!
}

type ImportResult {
  import: TransactionImport!
}

type BillImportJob {
  id: ID!
  importType: ImportType!
  status: BillImportJobStatus!
  fileName: String
  createdAt: DateTime!
  reviewPayload: BillImportReview
  errorCode: String
  errorParameters: JSON
  errorMessage: String @deprecated(reason: "Use errorCode/errorParameters for i18n")
}

type BillImportReview {
  bankName: String
  reviewMode: BillImportReviewMode!
  statementPeriod: DateRange
  cards: [BillImportReviewCard!]!
}

enum BillImportReviewMode {
  CARD_BUCKET_MATCHING
  TX_CARD_ASSIGNMENT
}

type DateRange {
  from: Date
  to: Date
}

type BillImportReviewCard {
  reviewCardId: ID!
  lastFourDigits: String
  holderName: String
  closingDate: Date
  dueDate: Date
  declaredTotal: Float!
  computedTotal: Float!
  totalMatchesDeclared: Boolean!
  transactions: [BillImportReviewTransaction!]!
  matchedFinancialAccountId: ID
  matchAmbiguous: Boolean!
  matchCandidates: [BillImportMatchCandidate!]!
}

type BillImportMatchCandidate {
  id: ID!
  name: String!
}

type BillImportReviewTransaction {
  date: Date
  description: String!
  amount: Float!
  creditDebitType: CreditDebitType!
  installment: InstallmentInfo
  isBillPayment: Boolean!
  categoryId: ID
  categorySource: CategorySource
}

type InstallmentInfo {
  current: Int!
  total: Int!
}

enum InvestmentImportJobStatus {
  AWAITING_REVIEW
  IMPORTING
  DONE
  FAILED
}

enum ConflictResolution {
  UPDATE
  KEEP_EXISTING
}

input SubmitInvestmentImportInput {
  fileName: String!
  fileBase64: String!
}

input ConfirmInvestmentImportInput {
  jobId: ID!
  institutionMappings: [InvestmentImportInstitutionMappingInput!]!
  rowPatches: [InvestmentImportRowPatchInput!]!
}

input InvestmentImportInstitutionMappingInput {
  reviewInstitutionId: String!
  financialAccountId: ID!
}

input InvestmentImportRowPatchInput {
  rowIndex: Int!
  principal: Float
  conflictResolution: ConflictResolution
  skip: Boolean
}

type InvestmentImportJob {
  id: ID!
  status: InvestmentImportJobStatus!
  fileName: String
  createdAt: DateTime!
  reviewPayload: InvestmentImportReview
  errorCode: String
  errorParameters: JSON
  errorMessage: String @deprecated(reason: "Use errorCode/errorParameters for i18n")
}

type InvestmentImportReview {
  source: String
  institutions: [InvestmentImportReviewInstitution!]!
}

type InvestmentImportReviewInstitution {
  reviewInstitutionId: String!
  institutionName: String!
  matchedFinancialAccountId: ID
  matchAmbiguous: Boolean!
  matchCandidates: [InvestmentImportAccountCandidate!]!
  rows: [InvestmentImportReviewRow!]!
}

