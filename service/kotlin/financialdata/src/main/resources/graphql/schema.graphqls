# External type reference - Asset is defined in the assets subgraph
# This is a stub type for federation - the full type is defined in the assets subgraph
# The id field is provided by this subgraph (from assetId in our data), and federation
# will use it to resolve the full Asset entity from the assets subgraph
type Asset @key(fields: "id") {
  id: ID!
}

# Query type for financial data operations
extend type Query {
  # Institution search queries
  # anoMes: Quarter filter (YYYYMM format). If not provided, uses latest quarter globally.
  searchBacenInstitutionsAutocomplete(query: String!, anoMes: String): BacenInstitutionAutocompleteConnection!
  bacenInstitutions(query: String, anoMes: String, first: Int, after: String): BacenInstitutionConnection!
  # Institution detail query
  # anoMes: Quarter filter (YYYYMM format). If not provided, uses latest quarter globally.
  bacenFinanceInstitution(id: ID!, anoMes: String): BacenFinanceInstitution
  # Rating issuers
  ratingIssuers: [RatingIssuer!]!
  # Economic indicators
  economicIndicators(label: String): [EconomicIndicator!]!
}

# Enums
enum BacenInstitutionType {
  INDIVIDUAL_INSTITUTION
  PRUDENTIAL_GROUP
  FINANCIAL_GROUP
}

enum BacenControlType {
  PUBLIC
  PRIVATE_DOMESTIC
  PRIVATE_FOREIGN_CONTROL
}

enum BacenInstitutionBankType {
  B1
  B2
  B3S
  B3C
  B4
  N1
  N2
  N4
}

enum DataRestrictionReason {
  INSTITUTION_REQUEST
}

type DataRestriction {
  isRestricted: Boolean!
  reason: DataRestrictionReason
}

# Institution search types
type BacenInstitutionAutocompleteConnection {
  suggestions: [BacenInstitutionAutocompleteItem!]!
}

type BacenInstitutionAutocompleteItem {
  name: String!
}

type BacenInstitutionConnection {
  edges: [BacenInstitutionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type BacenInstitutionEdge {
  node: BacenInstitutionSummaryItem!
  cursor: String!
}

type BacenInstitutionSummaryItem {
  id: ID!
  name: String!
  legalName: String
  tradeName: String
  logoAsset: Asset
  profit: Float
  equity: Float
  yoyEquityGrowth: Float
  basileiaIndex: Float
  bacenInstitutionType: String
  institutionType: BacenInstitutionType
  tipoConsolidadoBancario: String
  dataRestriction: DataRestriction
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

# Institution detail types
type BacenFinanceInstitution {
  id: ID!
  quarter: String
  updatedAt: DateTime
  name: String!
  asset: Asset
  legalName: String
  tradeName: String
  logoAsset: Asset
  institutionType: BacenInstitutionType
  controlType: BacenControlType
  institutionBankType: BacenInstitutionBankType
  tipoConsolidadoBancario: BacenInstitutionBankType
  website: String
  socialNetworks: [String!]
  mainActivity: String
  address: String
  founded: String
  rwaReferenceEquity: Float
  dataRestriction: DataRestriction

  # Reports
  reportsSummary(range: QuarterRangeInput!): ReportsAvailability!
  reportDetails(reportId: ID!, range: QuarterRangeInput!): ReportDetails!

  """
  Current ratings from all issuers for this institution
  """
  ratings: [InstitutionRating!]

  """
  Historical rating changes for this institution
  """
  ratingHistory(limit: Int = 50): [RatingHistory!]
}

input QuarterRangeInput {
  from: String # "YYYYMM"
  to: String   # "YYYYMM"
  last: Int
}

input IndicatorRangeInput {
  from: Date
  to: Date
  last: Int
}

type ReportsAvailability {
  quarters: [QuarterReports!]!
}

type QuarterReports {
  quarter: String! # "YYYYMM"
  reports: [ReportDescriptor!]!
}

type ReportDescriptor {
  reportId: ID!
  name: String
  # Optional fields - only present in reportDetails, not in reportsSummary
  group: String
  id: String
}

type ReportDetails {
  reportId: ID!
  name: String
  accounts: [ReportAccount!]!
}

type ReportAccount {
  group: String
  id: String
  name: String
  valuesByQuarter: [QuarterValue!]!
}

type QuarterValue {
  quarter: String! # "YYYYMM"
  value: Float
}

# Ratings types
type RatingIssuer {
  id: ID!
  code: String!
  name: String!
  website: String
  logoAssetId: String
}

type InstitutionRating {
  id: ID!
  name: String!
  label: String!
  ratingDate: Date!
  customParams: JSON
  issuer: RatingIssuer!
  updatedAt: DateTime!
}

type RatingHistory {
  id: ID!
  name: String!
  label: String!
  ratingDate: Date!
  customParams: JSON
  issuerCode: String!
  changedAt: DateTime!
}

# Economic indicators
type EconomicIndicator {
  id: ID!
  countryCode: String!
  label: String!
  issuer: String!
  description: String
  frequency: String!
  unit: String!
  isActive: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
  variations(label: String): [EconomicIndicatorVariation!]!
}

type EconomicIndicatorVariation {
  id: ID!
  label: String!
  unit: String
  isDefault: Boolean!
  incrementalMonths: Int
  incrementalYears: Int
  incrementalDays: Int
  series(range: IndicatorRangeInput, limit: Int): EconomicIndicatorVariationSeries
}

type EconomicIndicatorVariationSeries {
  unit: String
  values: [EconomicIndicatorPoint!]!
}

type EconomicIndicatorPoint {
  referenceDate: Date!
  value: Float!
}
