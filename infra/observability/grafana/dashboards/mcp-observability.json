          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(mcp_tool_catalog_fetch_failures_total[5m]))",
          "legendFormat": "catalog failures",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tool Catalog Fetch Failures",
      "type": "timeseries"
